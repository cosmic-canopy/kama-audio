// audio::BaseAudioContext and audio::OfflineAudioContext, Web Audio's contexts (decision 3), and the errors a make
// answers.
//
// - **`BaseAudioContext` is a contract,** as Web Audio's is the base of `AudioContext` and `OfflineAudioContext`. kama's
//   inheritance cannot carry it, since a derived type may not add a public member and each context adds its own. A node
//   is made from any context through it.
// - **A context is a resource,** and every node made from it holds its state (decision 4), so the state lives until the
//   last of them is dropped, the context's own handle included. It is drawn from the program's memory (decision 36):
//   the slot table, the command ring and the backlog, each of a declared capacity (decisions 6, 8 and 34), and the
//   block that holds them, made by `try new`.
// - **Every limit answers at the call,** never with a trap: an option outside what Web Audio allows is `NotSupported`,
//   as Web Audio's `NotSupportedError`; memory with no room for a declared capacity is `OutOfMemory`; a node made when
//   every row is held is `TooManyNodes`; a call with the backlog full is `TooManyCommands`; a connection with every
//   declared one held is `TooManyConnections`; and a connection to another context's node is `InvalidAccess`, as Web
//   Audio's `InvalidAccessError`.

import { audio::graph::ContextState, audio::graph::ContextKey, audio::graph::Command, audio::graph::NodeKind,
         audio::graph::stateFrom, AudioMemory, RenderRequest, AudioDestinationNode, std::memory::Shared };

export { BaseAudioContext, OfflineAudioContext, OfflineAudioContextOptions, AudioError };

// Why a context or a node was not made.
type enum AudioError implements Error {
    NotSupported, OutOfMemory, TooManyNodes, TooManyCommands, TooManyConnections, InvalidAccess, InvalidState, IndexSize,
    TooManySuspends, Range;

    public const fn string message() {
        return match (this) {
            case NotSupported: "an option is outside what Web Audio allows: 1 to 32 channels, a length of at least one frame, a sample rate from 3,000 to 768,000 Hz, 1 to 32 channels a node, and at least one of each declared capacity";
            case OutOfMemory: "the program's memory had no room for the context's declared capacities";
            case TooManyNodes: "every node row the context declared is held; a dropped node's row comes back once the audio side frees it";
            case TooManyCommands: "the context's backlog is full: every command it declared is waiting for the next flush";
            case TooManyConnections: "every connection the context declared is held; a freed node's connections come back once the way back is read";
            case InvalidAccess: "the node belongs to another context: nodes connect only within their own, as in Web Audio";
            case InvalidState: "the render is not in a state for the call, as Web Audio's InvalidStateError: started already, not started, or a suspend's frame at or before the current time, at or past the end, or taken";
            case IndexSize: "an index is out of bounds, as Web Audio's IndexSizeError: a channel a buffer does not have, a frame below 0, or the input of a node that has none";
            case TooManySuspends: "every suspend the context declared is scheduled; one is free again once the render reaches it";
            case Range: "a value is outside its range, as Web Audio's RangeError: a time negative, not finite, or past 2^51 frames";
        };
    }
}

type contract BaseAudioContext for resource {
    // The sample rate, in Hz, at which the context renders.
    const fn float32 sampleRate();

    // Web Audio's `destination`: the context's own node, whose input the context renders.
    fn AudioDestinationNode destination();

    // The state a node made from this context holds. Only the package can build a key.
    fn Shared<ContextState, AudioMemory> stateFor(ContextKey key);
}

// Web Audio's `OfflineAudioContextOptions`, with the package's declared capacities and the program's memory (decision 6).
type value OfflineAudioContextOptions {
    public int32 numberOfChannels = 1;
    public int64 length = 1;                 // in sample frames
    public float32 sampleRate = 44100;       // in Hz
    public isize nodeCapacity = 1024;        // the nodes a program can hold at once: the slot table's rows (decision 34); the destination is the context's own
    public isize ringCapacity = 1024;        // the commands that can cross to the audio side at once (decision 7)
    public isize backlogCapacity = 4096;     // the commands that can wait for a flush (decisions 8 and 33)
    public isize connectionCapacity = 4096;  // the connections between its nodes at once, four for each node row (decision 6)
    public int64 framesPerUpdate = 8192;     // the frames an update renders at least, in whole quanta (decision 37)
    public isize suspendCapacity = 64;       // the suspends a render can have scheduled at once (decisions 6 and 37)
    public int32 channelCapacity = 2;        // the most channels a node carries, or numberOfChannels when more (decision 38)
    public AudioMemory memory = AudioMemory.global();

    public ctor make(int64 length, float32 sampleRate) {
        this.length = length;
        this.sampleRate = sampleRate;
    }
}

// Web Audio's ranges: implementations support at least 32 channels and sample rates from 3,000 to 768,000 Hz. Each
// declared capacity is at least one.
comptime int32 MOST_CHANNELS = 32;
comptime float32 LOWEST_RATE = 3000;
comptime float32 HIGHEST_RATE = 768000;

type resource OfflineAudioContext implements BaseAudioContext {
    Shared<ContextState, AudioMemory> state;
    int32 channels = 1;
    int64 frames = 1;

    // The package's one test seam into a context: the tests program reads its rows and its due releases, flushes it,
    // reads its ring as the audio side would, renders a quantum on its audio side, reads the way back, and reads the
    // render's order.
    friend audiotests::rowsHeldIn[rowsHeld];
    friend audiotests::releaseDueIn[releaseDue];
    friend audiotests::flushIn[flush];
    friend audiotests::sentIn[sent];
    friend audiotests::quantumIn[renderQuantum];
    friend audiotests::pollIn[poll];
    friend audiotests::audioHeldIn[audioHeld];
    friend audiotests::refusedIn[refused];
    friend audiotests::forgeIn[forge];
    friend audiotests::forgeConnectIn[forgeConnect];
    friend audiotests::markIn[mark];
    friend audiotests::orderAtIn[orderAt];
    friend audiotests::mutedIn[muted];
    friend audiotests::lateIn[late];

    private ctor adopt(Shared<ContextState, AudioMemory> state, int32 channels, int64 frames) {
        this.state = give state;
        this.channels = channels;
        this.frames = frames;
    }

    // A context rendering `options.length` frames of `options.numberOfChannels` channels at `options.sampleRate`, its
    // state drawn from `options.memory`.
    public ctor Result<OfflineAudioContext, AudioError> make(OfflineAudioContextOptions options) {
        if (options.numberOfChannels < 1 || options.numberOfChannels > MOST_CHANNELS || options.length < 1
            || options.sampleRate < LOWEST_RATE || options.sampleRate > HIGHEST_RATE || options.nodeCapacity < 1
            || options.ringCapacity < 1 || options.backlogCapacity < 1 || options.connectionCapacity < 1
            || options.framesPerUpdate < 1 || options.suspendCapacity < 1 || options.channelCapacity < 1
            || options.channelCapacity > MOST_CHANNELS) {
            return Result::Err(error: AudioError::NotSupported);
        }
        Result<Shared<ContextState, AudioMemory>, AudioError> state =
            stateFrom(memory: options.memory, nodeCapacity: options.nodeCapacity, ringCapacity: options.ringCapacity,
                      backlogCapacity: options.backlogCapacity, connectionCapacity: options.connectionCapacity,
                      channels: options.numberOfChannels, channelCapacity: options.channelCapacity, length: options.length,
                      framesPerUpdate: options.framesPerUpdate, suspendCapacity: options.suspendCapacity,
                      sampleRate: options.sampleRate);
        return match (give state) {
            case Ok(value: s): Result::Ok(value: OfflineAudioContext.adopt(state: give s, channels: options.numberOfChannels,
                                                                            frames: options.length));
            case Err(error: e): Result::Err(error: e);
        };
    }

    public const fn float32 sampleRate() { return this.state.sampleRate(); }

    // Web Audio's `length`: the frames it renders.
    public const fn int64 length() { return this.frames; }

    public const fn int32 numberOfChannels() { return this.channels; }

    // Starts the render (Web Audio's `startRendering()`, decision 37): it renders nothing now, and answers the request
    // the program polls. `InvalidState` when the render has started already.
    public fn Result<RenderRequest, AudioError> startRendering() {
        if (!this.state.startRendering()) { return Result::Err(error: AudioError::InvalidState); }
        return Result::Ok(value: RenderRequest.of(state: copy this.state));
    }

    // The program's call once a frame (decisions 10 and 37): the calls made since the last one flushed to the audio side,
    // then, once the render has started, at least `options.framesPerUpdate` frames rendered in whole quanta, or the rest,
    // then the way back read.
    public fn void update() { this.state.update(); }

    // Schedules the render to stop at `suspendTime`, in seconds (Web Audio's `suspend(suspendTime)`, decision 37): the
    // time's frame (decision 3), quantized up to a quantum. The render stops before that quantum, `poll()` answers
    // `Suspended`, and the calls made until `resume()` land in that quantum. `InvalidState` when the frame is negative,
    // at or before the current time, at or past the end, or another suspend's; `TooManySuspends` when every declared
    // suspend is held.
    public fn Result<Unit, AudioError> suspend(float64 suspendTime) { return this.state.suspendAt(time: suspendTime); }

    // Goes on rendering after a suspend (Web Audio's `resume()`); taken while it runs, and changing nothing then.
    // `InvalidState` before the start.
    public fn Result<Unit, AudioError> resume() {
        if (!this.state.resume()) { return Result::Err(error: AudioError::InvalidState); }
        return Result::Ok(value: Unit::Unit);
    }

    // Web Audio's `currentTime`: the frames rendered so far over the sample rate, in seconds.
    public const fn float64 currentTime() { return this.state.currentTime(); }

    // Web Audio's `destination`: the node whose input the context renders, made with the context.
    public fn AudioDestinationNode destination() { return AudioDestinationNode.of(state: copy this.state); }

    public fn Shared<ContextState, AudioMemory> stateFor(ContextKey key) { return copy this.state; }

    private const fn isize rowsHeld() { return this.state.rowsHeld(); }

    private fn Optional<int64> releaseDue() { return this.state.nextRelease(); }

    private fn isize flush() { return this.state.flush(); }

    // The next command the audio side would take from the ring, as text.
    private fn Optional<string> sent() {
        Optional<Command> got = this.state.nextCommand();
        return match (got) {
            case Some(value: c): Optional::Some(value: c.describe());
            case None: Optional::None;
        };
    }

    // One render quantum on the audio side: answers how many commands it applied.
    private fn isize renderQuantum() { return this.state.renderQuantum(); }

    // The way back read on the program's side: answers how many rows its reports freed.
    private fn isize poll() { return this.state.poll(); }

    // The nodes the audio side holds.
    private const fn isize audioHeld() { return this.state.audioHeld(); }

    // The commands the audio side refused, each naming a node it did not hold.
    private const fn int64 refused() { return this.state.refused(); }

    // A command no call would send, added to the backlog: a make (`made`) or a release of `node`, any id at all.
    private fn bool forge(bool made, int64 node) {
        if (made) { return this.state.send(command: Command::Made(node: node, kind: NodeKind::Gain)); }
        return this.state.send(command: Command::Release(node: node));
    }

    // A mark in the render's output: `value` at `channel` and `frame`. False when either is out of range.
    private fn bool mark(int32 channel, int64 frame, float32 value) {
        return this.state.mark(channel: channel, frame: frame, value: value);
    }

    // The node at `position` in the render's order, or `None` past its end.
    private const fn Optional<int64> orderAt(int64 position) { return this.state.orderAt(position: position); }

    // Whether `node` is muted, in a cycle.
    private const fn bool muted(int64 node) { return this.state.muted(id: node); }

    // The starts the audio side applied late.
    private const fn int64 late() { return this.state.late(); }

    // A connection no call would send, added to the backlog: from `from`'s output to `to`'s input, any ids at all.
    private fn bool forgeConnect(int64 from, int64 to) { return this.state.send(command: Command::Connect(from: from, to: to)); }
}
