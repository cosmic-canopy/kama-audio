// audio::graph::Engine, the audio side (decisions 1, 4, 5, 9, 32 and 34), and audio::graph::Event, what it reports on
// the way back.
//
// - **A render quantum drains the command ring at its top** and applies every command published before it, in order,
//   each in that quantum (decision 32). Nothing a flush has not published reaches it.
// - **It keeps each node it is told of in its own `SlotArray`,** at the id's slot, and checks the id's generation, so a
//   command naming a node it no longer holds never reaches the node now in that slot (decisions 4 and 34). It keeps
//   the connections between them in `Connections` of its own. Every part is drawn with the rest of the context, on the
//   program's side, so the audio side never allocates (decision 5).
// - **A command it cannot apply is refused and counted,** never a trap: a make into a slot that holds a node, a
//   connection naming a node it does not hold at that generation, one it holds already or one past the declared, and a
//   release of a node it does not hold or has released. None can come from a call; each would be the package's bug,
//   and the count is how it is seen.
// - **A release follows Web Audio's lifetime rule** (decision 4): the audio side keeps a node while it can still sound,
//   and frees it once it cannot. A released node can sound while a node that can feeds it, through any chain of
//   connections; a node the program holds can, and so, when they come, can a playing source and a tail still ringing.
//   So in a quantum that applied a release, the walk marks every node reached from those along their outputs, and frees
//   every released node it did not reach, a cycle that nothing feeds included. A node's own outputs keep nothing alive.
//   It reports each node freed on the way back (decision 9), and the program side's read gives the row back
//   (decision 35).
// - **The walk is a mark from those nodes,** with an explicit stack in the marks' own storage, so it neither recurses
//   nor allocates. It costs a pass over the slots and the connections: at 1,024 nodes and 4,096 connections, 5.0 µs
//   natively on the M4 and 6.6 µs on wasm under node, a quarter of a percent of a 128-frame quantum at 48 kHz
//   (`.scratch/aud1-mark/`, 2026-11-18). A quantum that releases nothing does not walk.
// - **The render's order is Web Audio's ordered node list:** every node it holds, each after every node that feeds it,
//   whether or not it reaches the destination (Web Audio's §1.5: processing happens "regardless of whether these
//   outputs ultimately reach an AudioContext's AudioDestinationNode"). A node in a cycle is muted and left out, as Web
//   Audio's rendering algorithm mutes a cycle with no `DelayNode` in it, and there is no `DelayNode` yet. One search
//   along the outputs finds both, Tarjan's strongly connected components: a component closes only after every
//   component it feeds, so the order is the closing order reversed, and a component of more than one node, or a node
//   connected to itself, is a cycle. Its stacks are in the marks' storage, so it neither recurses nor allocates. It runs
//   in a quantum whose commands or walk changed the graph (a make, a connection, a free), after the walk.
// - **The destination is the context's own node,** placed at the make at the slot past the program side's rows, so no
//   command makes it and no release names it; never released, it can always sound.
// - **The way back always has room for a report:** its capacity is the node capacity, and a slot is reported freed at
//   most once before the program side reads the report, since only that read lets the slot be taken again. So a
//   report is never refused, and a row never leaks.
//
// It runs on the audio thread for a real-time context, and on the program's thread for an offline render. Either way it
// is handed the two rings it reads and writes, and owns only its nodes, its connections and its marks.

import { audio::AudioMemory, audio::AudioError, audio::rt::Ring, audio::rt::SlotArray, audio::rt::CapacityError,
         audio::rt::slotOf, audio::store::Slots, Command, NodeKind, Connections, NO_CONNECTION };

export { Engine, Event, EngineNode, Mark, engineFrom, QUANTUM };

// The frames of one render quantum: Web Audio's 128, until the engine's declared block (decision 15, AUD-9) makes it the
// program's setting.
comptime int64 QUANTUM = 128;

// What the audio side reports on the way back (decision 9). Each kind arrives with what sends it: a sound's end with
// the first source, an error and a block handed back with theirs.
type enum Event {
    Freed(int64 node);
}

// What the audio side keeps of a node, at its id's slot.
type value EngineNode {
    public NodeKind kind = NodeKind::Gain;
    public bool released = false;    // the program holds it no more
    public bool muted = false;       // in a cycle: left out of the render's order

    public ctor make(NodeKind kind) {
        this.kind = kind;
        this.released = false;
        this.muted = false;
    }
}

// A slot's place in the lifetime walk and in the order's search, and, at a stack position, the slot waiting there.
type value Mark {
    public bool reached = false;    // the walk: reached from a node that can sound
    public int64 waiting = 0;       // at a stack position: the slot the walk, or the search, comes back to
    public int64 visited = -1;      // the search: when it first reached the slot, or -1
    public int64 lowest = 0;        //   the earliest-reached slot still open that the slot reaches
    public int64 next = -1;         //   the slot's next connection to follow
    public bool open = false;       //   the slot is in a component not yet closed
    public bool loops = false;      //   the slot is connected to itself
    public int64 pending = 0;       // at a stack position: a slot of a component not yet closed
}

// The audio side drawn from `memory`, each part only once the one before it fit: its array of `slots` nodes, its
// connections (`connectionCapacity`, and a list head for each slot), the marks of the walk and the search, one a slot,
// the render's order, one a slot, then its block, a quantum for each of `channels` channels. `OutOfMemory` when a part
// has no room, and every part taken before it goes back. The destination, `destination`, is held from the start.
fn Result<Engine, AudioError> engineFrom(AudioMemory memory, isize slots, isize connectionCapacity, int32 channels,
                                         int64 destination) {
    Result<SlotArray<EngineNode, AudioMemory>, CapacityError> array =
        SlotArray::<EngineNode, AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: slots);
    SlotArray<EngineNode, AudioMemory> nodes = match (give array) {
        case Ok(value: a): give a;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Connections, CapacityError> made =
        Connections.withCapacity(memory: memory, nodes: slots, connections: connectionCapacity);
    Connections edges = match (give made) {
        case Ok(value: c): give c;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Slots<Mark, AudioMemory>, CapacityError> taken = Slots::<Mark, AudioMemory>.take(allocator: memory, capacity: slots);
    Slots<Mark, AudioMemory> marks = match (give taken) {
        case Ok(value: m): give m;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Slots<int64, AudioMemory>, CapacityError> listed = Slots::<int64, AudioMemory>.take(allocator: memory, capacity: slots);
    Slots<int64, AudioMemory> order = match (give listed) {
        case Ok(value: o): give o;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Slots<float32, AudioMemory>, CapacityError> blockTaken =
        Slots::<float32, AudioMemory>.take(allocator: memory, capacity: cast<isize>(channels) * cast<isize>(QUANTUM));
    Slots<float32, AudioMemory> block = match (give blockTaken) {
        case Ok(value: b): give b;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    return Result::Ok(value: Engine.make(nodes: give nodes, edges: give edges, marks: give marks, order: give order,
                                         block: give block, channels: channels, destination: destination));
}

type resource Engine {
    SlotArray<EngineNode, AudioMemory> nodes;
    Connections edges;
    Slots<Mark, AudioMemory> marks;
    Slots<int64, AudioMemory> order;     // the render's order: [0, ordered) the ids of the nodes it runs, in turn
    Slots<float32, AudioMemory> block;   // the quantum rendered: each channel's QUANTUM frames after the one before it
    int32 channelCount = 1;
    int64 refusedCount = 0;
    int64 ordered = 0;
    bool released = false;   // a release applied this quantum, so the walk is due
    bool changed = true;     // the graph changed since the order was found, so the search is due

    public ctor make(SlotArray<EngineNode, AudioMemory> nodes, Connections edges, Slots<Mark, AudioMemory> marks,
                     Slots<int64, AudioMemory> order, Slots<float32, AudioMemory> block, int32 channels,
                     int64 destination) {
        this.nodes = give nodes;
        this.edges = give edges;
        this.marks = give marks;
        this.order = give order;
        this.block = give block;
        this.channelCount = channels;
        this.refusedCount = 0;
        this.ordered = 0;
        this.released = false;
        this.changed = true;
        bool placed = this.nodes.put(id: destination, value: EngineNode.make(kind: NodeKind::Destination));
    }

    // One render quantum: every command published before it applied in order; then, if one was a release, the walk;
    // then, if the graph changed, the order's search; then the reports they made published on the way back with one
    // store; then the quantum's samples into the block. No node renders samples yet, so they are silence. Answers how
    // many commands it applied.
    @noheap public fn isize renderQuantum(ref Ring<Command, AudioMemory> commands, ref Ring<Event, AudioMemory> events) {
        isize applied = 0;
        bool more = true;
        while (more) {
            Optional<Command> got = commands.pop();
            match (got) {
                case Some(value: c): {
                    this.apply(command: c);
                    applied = applied + 1;
                }
                case None: { more = false; }
            };
        }
        if (this.released) {
            this.collect(events: events);
            this.released = false;
        }
        if (this.changed) {
            this.sort();
            this.changed = false;
        }
        events.publish();
        int64 samples = this.block.count();
        int64 i = 0;
        while (i < samples) {
            this.block[i] = 0;
            i = i + 1;
        }
        return applied;
    }

    // The sample the last quantum rendered for `channel` at `frame`, of QUANTUM.
    public const fn float32 blockAt(int32 channel, int64 frame) { return this.block[cast<int64>(channel) * QUANTUM + frame]; }

    @noheap fn void apply(Command command) {
        match (command) {
            case Made(node: id, kind: k): {
                if (this.nodes.put(id: id, value: EngineNode.make(kind: k))) {
                    this.changed = true;
                } else {
                    this.refusedCount = this.refusedCount + 1;
                }
            }
            case Connect(from: f, to: t): {
                Optional<EngineNode> source = this.nodes.at(id: f);
                Optional<EngineNode> sink = this.nodes.at(id: t);
                if (!source.isSome() || !sink.isSome() || this.edges.has(from: f, to: t) || !this.edges.add(from: f, to: t)) {
                    this.refusedCount = this.refusedCount + 1;
                } else {
                    this.changed = true;
                }
            }
            case Release(node: id): {
                Optional<EngineNode> held = this.nodes.at(id: id);
                match (held) {
                    case Some(value: n): {
                        if (n.released) {
                            this.refusedCount = this.refusedCount + 1;
                        } else {
                            EngineNode now = n;
                            now.released = true;
                            bool set = this.nodes.set(id: id, value: now);
                            this.released = true;
                        }
                    }
                    case None: { this.refusedCount = this.refusedCount + 1; }
                };
            }
        };
    }

    // The lifetime walk: marks every node a node that can sound reaches along its outputs, then frees every node it did
    // not reach, which the program has released, taking its connections with it and reporting it.
    @noheap fn void collect(ref Ring<Event, AudioMemory> events) {
        int64 slots = this.marks.count();
        int64 top = 0;
        int64 slot = 0;
        while (slot < slots) {
            this.marks[slot].reached = false;
            slot = slot + 1;
        }
        slot = 0;
        while (slot < slots) {
            int64 id = this.nodes.idAt(slot: slot);
            if (id != 0 && this.canSound(id: id)) {
                this.marks[slot].reached = true;
                this.marks[top].waiting = slot;
                top = top + 1;
            }
            slot = slot + 1;
        }
        while (top > 0) {
            top = top - 1;
            int64 from = this.marks[top].waiting;
            int64 edge = this.edges.firstOut(slot: from);
            while (edge != NO_CONNECTION) {
                int64 to = slotOf(id: this.edges.toOf(edge: edge));
                if (!this.marks[to].reached) {
                    this.marks[to].reached = true;
                    this.marks[top].waiting = to;
                    top = top + 1;
                }
                edge = this.edges.nextOut(edge: edge);
            }
        }
        slot = 0;
        while (slot < slots) {
            int64 id = this.nodes.idAt(slot: slot);
            if (id != 0 && !this.marks[slot].reached) {
                isize gone = this.edges.removeFrom(from: id);
                bool removed = this.nodes.remove(id: id);
                bool reported = events.stage(item: Event::Freed(node: id));   // always room: see the file's head
                this.changed = true;
            }
            slot = slot + 1;
        }
    }

    // The order's search (Tarjan's strongly connected components, along the outputs): from each slot not yet reached,
    // it follows each connection in turn, and a slot closes its component once every slot it reaches has closed and none
    // reaches back above it. So the components close sinks first; each closed one goes into the order, but a cycle,
    // which is muted; and the order is then reversed, every node after every node that feeds it.
    @noheap fn void sort() {
        int64 slots = this.marks.count();
        int64 slot = 0;
        while (slot < slots) {
            this.marks[slot].visited = -1;
            this.marks[slot].loops = false;
            slot = slot + 1;
        }
        this.ordered = 0;
        int64 reached = 0;   // how many slots the search has reached
        int64 pending = 0;   // the open components' slots, at the stack positions [0, pending)
        slot = 0;
        while (slot < slots) {
            if (this.nodes.idAt(slot: slot) != 0 && this.marks[slot].visited < 0) {
                this.reach(slot: slot, at: reached, pending: pending);
                reached = reached + 1;
                pending = pending + 1;
                int64 top = 1;    // the search's own stack, at the stack positions [0, top)
                this.marks[0].waiting = slot;
                while (top > 0) {
                    int64 from = this.marks[top - 1].waiting;
                    int64 edge = this.marks[from].next;
                    if (edge != NO_CONNECTION) {
                        this.marks[from].next = this.edges.nextOut(edge: edge);
                        int64 to = slotOf(id: this.edges.toOf(edge: edge));
                        if (to == from) { this.marks[from].loops = true; }
                        if (this.marks[to].visited < 0) {
                            this.reach(slot: to, at: reached, pending: pending);
                            reached = reached + 1;
                            pending = pending + 1;
                            this.marks[top].waiting = to;
                            top = top + 1;
                        } else if (this.marks[to].open && this.marks[to].visited < this.marks[from].lowest) {
                            this.marks[from].lowest = this.marks[to].visited;
                        }
                    } else {
                        top = top - 1;
                        if (top > 0) {
                            int64 back = this.marks[top - 1].waiting;
                            if (this.marks[from].lowest < this.marks[back].lowest) {
                                this.marks[back].lowest = this.marks[from].lowest;
                            }
                        }
                        if (this.marks[from].lowest == this.marks[from].visited) {
                            int64 first = pending - 1;
                            while (this.marks[first].pending != from) { first = first - 1; }
                            bool cycle = pending - first > 1 || this.marks[from].loops;
                            int64 k = first;
                            while (k < pending) {
                                this.close(slot: this.marks[k].pending, muted: cycle);
                                k = k + 1;
                            }
                            pending = first;
                        }
                    }
                }
            }
            slot = slot + 1;
        }
        int64 low = 0;
        int64 high = this.ordered - 1;
        while (low < high) {
            int64 kept = this.order[low];
            this.order[low] = this.order[high];
            this.order[high] = kept;
            low = low + 1;
            high = high - 1;
        }
    }

    // The search reaches `slot`, the `at`th it has reached, and opens it at the stack position `pending`.
    @noheap fn void reach(int64 slot, int64 at, int64 pending) {
        this.marks[slot].visited = at;
        this.marks[slot].lowest = at;
        this.marks[slot].next = this.edges.firstOut(slot: slot);
        this.marks[slot].open = true;
        this.marks[pending].pending = slot;
    }

    // The search closes `slot`: muted when its component is a cycle, and otherwise next in the order.
    @noheap fn void close(int64 slot, bool muted) {
        this.marks[slot].open = false;
        int64 id = this.nodes.idAt(slot: slot);
        Optional<EngineNode> held = this.nodes.at(id: id);
        match (held) {
            case Some(value: n): {
                if (n.muted != muted) {
                    EngineNode now = n;
                    now.muted = muted;
                    bool set = this.nodes.set(id: id, value: now);
                }
            }
            case None: { }
        };
        if (!muted) {
            this.order[this.ordered] = id;
            this.ordered = this.ordered + 1;
        }
    }

    // The id of the node at `position` in the render's order, or `None` past its end.
    public const fn Optional<int64> orderAt(int64 position) {
        if (position < 0 || position >= this.ordered) { return Optional::None; }
        return Optional::Some(value: this.order[position]);
    }

    // Whether the node `id` names is muted, in a cycle. False for a node it does not hold.
    public const fn bool isMuted(int64 id) {
        Optional<EngineNode> held = this.nodes.at(id: id);
        return match (held) {
            case Some(value: n): n.muted;
            case None: false;
        };
    }

    // Whether the node `id` names can sound of itself: so far, whether the program still holds it. A playing source and
    // a tail still ringing join it when they come.
    @noheap const fn bool canSound(int64 id) {
        Optional<EngineNode> held = this.nodes.at(id: id);
        return match (held) {
            case Some(value: n): !n.released;
            case None: false;
        };
    }

    // How many of the program's nodes the audio side holds: the destination, the context's own, is not one.
    public const fn isize held() { return this.nodes.length() - 1; }

    // How many commands it has refused.
    public const fn int64 refused() { return this.refusedCount; }
}
