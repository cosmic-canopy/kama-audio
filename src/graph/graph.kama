// audio::graph, the parts a context and every node made from it share (decisions 4, 9, 34, 35 and 36), and the audio
// side they drive (`engine.kama`). The module is internal: the package's own modules import it, and no program can.
//
// - **`ContextState`** is what a context's handles share: the program side's slot table, whose rows count the nodes
//   (decision 34), the backlog every call's command waits in and the ring a flush moves it into (decisions 7, 8 and
//   33), the way back the audio side reports on (decision 9), the audio side itself, and the context's fixed
//   properties, its destination among them: the context's own node, at the slot past the table's rows, which takes no
//   row since a program never makes or releases it. `stateFrom` draws its parts from the program's memory (decision 36), the state itself one block made
//   by `try new`, all freed with the last hold, the context's or a node's. Its `poll()` reads the way back and gives
//   each freed node's row back to the table.
// - **`NodeHold`** is a node's hold on its context's state and on its row: a copy counts the row up, a drop counts it
//   down, and the last drop marks the row for release (decision 35). The audio thread never touches a count
//   (decision 4).
// - **`ContextKey`** is what `BaseAudioContext.stateFor` asks for, so only `NodeHold.take` can reach a context's state.
// - **`Command`** is what a call sends the audio side (decisions 7, 32 and 33): a flat, typed value naming its node by
//   the id of its row, never by a pointer.

import { audio::AudioMemory, audio::AudioError, audio::BaseAudioContext, audio::AudioNode, audio::rt::SlotTable,
         audio::rt::Ring, audio::rt::Backlog, audio::rt::CapacityError, audio::rt::slotOf, audio::rt::generationOf,
         audio::store::Slots, std::memory::Shared, Engine, Event, Connections, engineFrom, Samples, samplesFrom,
         QUANTUM, frameAt };

export { ContextState, NodeHold, ContextKey, NodeLink, Command, NodeKind, stateFrom };

// The kind of node a `Made` command makes, with what its make sets: a constant source's offset (decision 39).
type enum NodeKind {
    Gain, Destination, Constant(float32 offset);

    public const fn string name() {
        return match (this) { case Gain: "gain"; case Destination: "destination"; case Constant(offset: o): "constant"; };
    }

    // Whether the node is a source a start schedules.
    public const fn bool isSource() {
        return match (this) { case Gain: false; case Destination: false; case Constant(offset: o): true; };
    }
}

// An id's generation 1 (decision 34): the high 32 bits of an id, over its slot's low 32.
comptime int64 FIRST_GENERATION_ID = 4294967296;

// A row's source state: its start sent.
comptime uint8 STARTED = 1;

// A call's command (decision 7): flat bytes, so it crosses a ring or a transferred buffer as it is, and typed, so the
// audio side applies each kind by name. A node is named by its row's id, its slot and generation (decision 34), and a
// call's time travels as the frame decision 3's rule gave it (decision 32).
type enum Command {
    Made(int64 node, NodeKind kind),
    Connect(int64 from, int64 to),
    Start(int64 node, int64 frame),
    Release(int64 node);

    // The command as text, for a test's or a log's reading: `made gain 0:1`, `connect 0:1 to 1:1`, `start 0:1 at 256`,
    // `release 0:1`, each node as its slot and generation.
    public const fn string describe() {
        return match (this) {
            case Made(node: n, kind: k): {
                string what = k.name();
                int64 slot = slotOf(id: n);
                int64 generation = generationOf(id: n);
                return "made ${what} ${slot}:${generation}";
            }
            case Connect(from: f, to: t): {
                int64 fromSlot = slotOf(id: f);
                int64 fromGeneration = generationOf(id: f);
                int64 toSlot = slotOf(id: t);
                int64 toGeneration = generationOf(id: t);
                return "connect ${fromSlot}:${fromGeneration} to ${toSlot}:${toGeneration}";
            }
            case Start(node: n, frame: f): {
                int64 slot = slotOf(id: n);
                int64 generation = generationOf(id: n);
                return "start ${slot}:${generation} at ${f}";
            }
            case Release(node: n): {
                int64 slot = slotOf(id: n);
                int64 generation = generationOf(id: n);
                return "release ${slot}:${generation}";
            }
        };
    }
}

type resource ContextState {
    SlotTable<AudioMemory> nodes;
    Backlog<Command, AudioMemory> waiting;
    Ring<Command, AudioMemory> commands;
    Ring<Event, AudioMemory> events;
    Connections links;
    Engine engine;
    Shared<Samples, AudioMemory> rendering;   // an offline render's output, its length the context's
    Slots<int64, AudioMemory> suspends;       // the frames a render will stop at, ascending, in [0, suspendCount)
    Slots<uint8, AudioMemory> sources;        // by row: STARTED once a source's start is sent
    float32 rate = 0;
    int64 destinationId = 0;                  // the context's own node, at the slot past the table's rows
    int64 perUpdate = 1;                      // the frames an update renders at least, in whole quanta (decision 37)
    int64 renderedSoFar = 0;
    int64 suspendCount = 0;
    bool started = false;
    bool suspended = false;

    public ctor make(SlotTable<AudioMemory> nodes, Ring<Command, AudioMemory> commands,
                     Backlog<Command, AudioMemory> waiting, Ring<Event, AudioMemory> events, Connections links,
                     Engine engine, Shared<Samples, AudioMemory> output, Slots<int64, AudioMemory> suspends,
                     Slots<uint8, AudioMemory> sources, int64 destination, int64 framesPerUpdate, float32 sampleRate) {
        this.nodes = give nodes;
        this.commands = give commands;
        this.waiting = give waiting;
        this.events = give events;
        this.links = give links;
        this.engine = give engine;
        this.rendering = give output;
        this.suspends = give suspends;
        this.sources = give sources;
        this.destinationId = destination;
        this.perUpdate = framesPerUpdate;
        this.renderedSoFar = 0;
        this.suspendCount = 0;
        this.started = false;
        this.suspended = false;
        this.rate = sampleRate;
    }

    // Schedules the render to stop at `time` (Web Audio's `suspend(suspendTime)`, decision 37): its frame by decision
    // 3's rule, quantized up to a quantum. `InvalidState` when that frame is negative, at or before the current time,
    // at or past the end, or one another suspend holds; `TooManySuspends` when every declared suspend is held.
    public fn Result<Unit, AudioError> suspendAt(float64 time) {
        Optional<int64> at = frameAt(time: time, sampleRate: this.rate);
        int64 frame = match (at) {
            case Some(value: f): f;
            case None: { return Result::Err(error: AudioError::InvalidState); }
        };
        int64 quantum = (frame + QUANTUM - 1) / QUANTUM * QUANTUM;
        if (quantum <= this.renderedSoFar || quantum >= this.rendering.frames()) {
            return Result::Err(error: AudioError::InvalidState);
        }
        int64 place = 0;
        while (place < this.suspendCount && this.suspends[place] < quantum) { place = place + 1; }
        if (place < this.suspendCount && this.suspends[place] == quantum) { return Result::Err(error: AudioError::InvalidState); }
        if (this.suspendCount >= this.suspends.count()) { return Result::Err(error: AudioError::TooManySuspends); }
        int64 i = this.suspendCount;
        while (i > place) {
            this.suspends[i] = this.suspends[i - 1];
            i = i - 1;
        }
        this.suspends[place] = quantum;
        this.suspendCount = this.suspendCount + 1;
        return Result::Ok(value: Unit::Unit);
    }

    // Goes on rendering after a suspend (Web Audio's `resume()`). False before the start, and then nothing changes.
    public fn bool resume() {
        if (!this.started) { return false; }
        this.suspended = false;
        return true;
    }

    // Whether the render is stopped at a suspend.
    public const fn bool renderSuspended() { return this.suspended; }

    // The render's time: the frames rendered so far over the sample rate, in seconds.
    public const fn float64 currentTime() { return cast<float64>(this.renderedSoFar) / cast<float64>(this.rate); }

    // Starts the offline render (decision 37). False when it has started already, and then nothing changes.
    public fn bool startRendering() {
        if (this.started) { return false; }
        this.started = true;
        return true;
    }

    // The program's `update()` (decisions 10 and 37): the flush; then, while a started render that is not suspended has
    // frames left, whole quanta until this update has rendered at least its declared frames, each copied into the
    // output, the last stopping at its length, and the render stopping on reaching a suspend's frame; then the way back
    // read.
    public fn void update() {
        isize sent = this.flush();
        int64 length = this.rendering.frames();
        int32 channels = this.rendering.channels();
        int64 thisUpdate = 0;
        while (this.started && !this.suspended && this.renderedSoFar < length && thisUpdate < this.perUpdate) {
            isize applied = this.renderQuantum();
            int64 frames = length - this.renderedSoFar < QUANTUM ? length - this.renderedSoFar : QUANTUM;
            int32 channel = 0;
            while (channel < channels) {
                int64 frame = 0;
                while (frame < frames) {
                    this.rendering.write(channel: channel, frame: this.renderedSoFar + frame,
                                         value: this.engine.blockAt(channel: channel, frame: frame));
                    frame = frame + 1;
                }
                channel = channel + 1;
            }
            this.renderedSoFar = this.renderedSoFar + frames;
            thisUpdate = thisUpdate + frames;
            // A suspend's frame is past the render when it is scheduled, so the render reaches it here, after a
            // quantum, and stops before the next: poll() says so at once, and the calls made until resume() land in it.
            if (this.suspendCount > 0 && this.suspends[0] == this.renderedSoFar) {
                int64 i = 1;
                while (i < this.suspendCount) {
                    this.suspends[i - 1] = this.suspends[i];
                    i = i + 1;
                }
                this.suspendCount = this.suspendCount - 1;
                this.suspended = true;
            }
        }
        isize freed = this.poll();
    }

    // Whether the render has rendered every frame of its length. Frames are rendered only once it has started, and its
    // length is at least one, so a render not started is never done.
    public const fn bool renderDone() { return this.renderedSoFar >= this.rendering.frames(); }

    // Writes `value` into the render's output at `channel` and `frame`: the tests' mark, which a render's overrun or a
    // read of the wrong channel or frame would show where silence cannot. False when either is out of range.
    public fn bool mark(int32 channel, int64 frame, float32 value) {
        if (channel < 0 || channel >= this.rendering.channels() || frame < 0 || frame >= this.rendering.frames()) {
            return false;
        }
        this.rendering.write(channel: channel, frame: frame, value: value);
        return true;
    }

    // The frames the render has rendered so far.
    public const fn int64 framesRendered() { return this.renderedSoFar; }

    // The render's output, shared with the `AudioBuffer` that hands it over.
    public fn Shared<Samples, AudioMemory> output() { return copy this.rendering; }

    // Where this state is: what tells one context from another.
    public unsafe const fn UnsafeConstPtr<ContextState> where() { return addr(of: this); }

    // Connects the output of the node `from` names to `destination`'s input (`AudioNode.connect`): recorded on the
    // program side and its command sent. A connection already held is taken and sends nothing. `InvalidAccess` for a
    // node of another context, `TooManyCommands` with the backlog full, then `TooManyConnections` with every declared
    // one held, and a refusal changes nothing.
    public unsafe fn Result<Unit, AudioError> connectFrom(int64 from, AudioNode destination) {
        ContextKey key = ContextKey.mint();
        NodeLink to = destination.linkFor(key: key);
        if (to.state != this.where()) { return Result::Err(error: AudioError::InvalidAccess); }
        if (this.links.has(from: from, to: to.id)) { return Result::Ok(value: Unit::Unit); }
        if (!this.canSend()) { return Result::Err(error: AudioError::TooManyCommands); }
        if (this.links.length() >= this.links.capacity()) { return Result::Err(error: AudioError::TooManyConnections); }
        bool linked = this.links.add(from: from, to: to.id);
        bool sent = this.send(command: Command::Connect(from: from, to: to.id));
        return Result::Ok(value: Unit::Unit);
    }

    // The context's own node, the destination: its id, at the slot past the table's rows, and its channels, the
    // context's.
    public const fn int64 destination() { return this.destinationId; }

    public const fn int32 channels() { return this.rendering.channels(); }

    // The node at `position` in the render's order, or `None` past its end; and whether the node `id` names is muted.
    public const fn Optional<int64> orderAt(int64 position) { return this.engine.orderAt(position: position); }

    public const fn bool muted(int64 id) { return this.engine.isMuted(id: id); }

    public const fn float32 sampleRate() { return this.rate; }

    // A row for a new node, counted once, its source state cleared, or `None` when every row is held.
    public fn Optional<int64> takeRow() {
        Optional<int64> taken = this.nodes.take();
        match (taken) {
            case Some(value: id): { this.sources[slotOf(id: id)] = 0; }
            case None: { }
        };
        return taken;
    }

    // Starts the source in row `node` at `startTime`, in seconds (Web Audio's `start(when)`): the time's frame by decision
    // 3's rule, sent in its command (decision 32). `InvalidState` when it has started already, `Range` for a time
    // negative, not finite or past 2^51 frames, `TooManyCommands` with the backlog full, in Web Audio's order, and a
    // refusal changes nothing.
    public fn Result<Unit, AudioError> startSource(int64 node, float64 startTime) {
        int64 slot = slotOf(id: node);
        if ((this.sources[slot] & STARTED) != 0) { return Result::Err(error: AudioError::InvalidState); }
        Optional<int64> at = frameAt(time: startTime, sampleRate: this.rate);
        int64 frame = match (at) {
            case Some(value: f): f;
            case None: { return Result::Err(error: AudioError::Range); }
        };
        if (!this.canSend()) { return Result::Err(error: AudioError::TooManyCommands); }
        bool sent = this.send(command: Command::Start(node: node, frame: frame));
        this.sources[slot] = this.sources[slot] | STARTED;
        return Result::Ok(value: Unit::Unit);
    }

    // How many starts the audio side applied late.
    public const fn int64 late() { return this.engine.late(); }

    // A copy of the node `id` names.
    public fn bool countUp(int64 id) { return this.nodes.countUp(id: id); }

    // A drop of the node `id` names; the last marks its row for release.
    public fn bool countDown(int64 id) { return this.nodes.countDown(id: id); }

    // The id of the node dropped longest ago whose release is due (decision 35), or `None`.
    public fn Optional<int64> nextRelease() { return this.nodes.nextRelease(); }

    // The rows held: nodes the program holds, and nodes dropped whose rows the audio side has not freed.
    public const fn isize rowsHeld() { return this.nodes.length(); }

    // Whether the backlog has room for one more command.
    public const fn bool canSend() { return this.waiting.length() < this.waiting.capacity(); }

    // Adds `command` behind the backlog's. False when the backlog is full, and then nothing is added.
    public fn bool send(Command command) { return this.waiting.add(item: command); }

    // The flush (decision 33): the backlog's commands moved into the ring, then, once the backlog has drained, the due
    // releases while the ring has room (decision 35), all published with one store. Answers how many it sent.
    // - A release goes only behind a drained backlog, so it never overtakes a command added before its node's last drop.
    //   With the ring drained on another thread, room can open between the move and the releases, so this is checked,
    //   not inferred from the room.
    // - A release is taken from the table only when the ring has room for it, so none is handed over and not sent: a
    //   row stays marked, and its release due, until a flush has room.
    public fn isize flush() {
        isize sent = this.waiting.stageInto(ring: this.commands);
        if (this.waiting.length() == 0) {
            bool more = true;
            while (more && this.commands.room() > 0) {
                Optional<int64> due = this.nodes.nextRelease();
                match (due) {
                    case Some(value: id): {
                        bool staged = this.commands.stage(item: Command::Release(node: id));
                        sent = sent + 1;
                    }
                    case None: { more = false; }
                };
            }
        }
        this.commands.publish();
        return sent;
    }

    // The audio side's next command from the ring, or `None` when it holds none published. An offline render takes its
    // commands on the program's thread; a real-time context's audio side reads the same ring.
    public fn Optional<Command> nextCommand() { return this.commands.pop(); }

    // One render quantum on the audio side, which an offline render runs on the program's thread: the commands the
    // flushes published, applied, and their reports published on the way back. Answers how many it applied.
    public fn isize renderQuantum() { return this.engine.renderQuantum(commands: this.commands, events: this.events); }

    // The way back read (decision 9): each report the audio side published, in the order it made them. A node freed
    // takes its connections with it, and gives its row back to the table, which reuses it at the next generation
    // (decision 34). Every node connected into it was freed in the same walk, so their reports take those connections.
    // Answers how many rows came back.
    public fn isize poll() {
        isize freed = 0;
        bool more = true;
        while (more) {
            Optional<Event> got = this.events.pop();
            match (got) {
                case Some(value: e): {
                    match (e) {
                        case Freed(node: id): {
                            isize gone = this.links.removeFrom(from: id);
                            if (this.nodes.free(id: id)) { freed = freed + 1; }
                        }
                    };
                }
                case None: { more = false; }
            };
        }
        return freed;
    }

    // How many nodes the audio side holds.
    public const fn isize audioHeld() { return this.engine.held(); }

    // How many commands the audio side has refused.
    public const fn int64 refused() { return this.engine.refused(); }
}

// A context's state drawn from `memory` (decision 36), each part only once the one before it fit: its slot table of
// `nodeCapacity` rows, its command ring of `ringCapacity`, its backlog of `backlogCapacity`, the way back of
// `nodeCapacity` (decision 9: a report for every row at once), its connections (`connectionCapacity`, and a list head
// for each row and the destination), the audio side (`engineFrom`, its nodes carrying at most `channelCapacity`
// channels, or the context's when more), the offline render's output of `channels` channels of `length` frames
// (`samplesFrom`), its `suspendCapacity` suspends, a source state for each row, then the block that holds them. A part
// with no room is `OutOfMemory`, and every part taken before it goes back when this returns.
fn Result<Shared<ContextState, AudioMemory>, AudioError> stateFrom(AudioMemory memory, isize nodeCapacity,
                                                                   isize ringCapacity, isize backlogCapacity,
                                                                   isize connectionCapacity, int32 channels,
                                                                   int32 channelCapacity, int64 length,
                                                                   int64 framesPerUpdate, isize suspendCapacity,
                                                                   float32 sampleRate) {
    // The destination takes the slot past the table's rows, which must fit an id's 32 bits: 2^32 rows or more leave it
    // none, and are refused before the allocator is asked, so the slots below cannot overflow either.
    if (cast<int64>(nodeCapacity) >= FIRST_GENERATION_ID) { return Result::Err(error: AudioError::OutOfMemory); }
    Result<SlotTable<AudioMemory>, CapacityError> table =
        SlotTable::<AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: nodeCapacity);
    SlotTable<AudioMemory> nodes = match (give table) {
        case Ok(value: t): give t;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Ring<Command, AudioMemory>, CapacityError> ring =
        Ring::<Command, AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: ringCapacity);
    Ring<Command, AudioMemory> commands = match (give ring) {
        case Ok(value: r): give r;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Backlog<Command, AudioMemory>, CapacityError> backlog =
        Backlog::<Command, AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: backlogCapacity);
    Backlog<Command, AudioMemory> waiting = match (give backlog) {
        case Ok(value: w): give w;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Ring<Event, AudioMemory>, CapacityError> back =
        Ring::<Event, AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: nodeCapacity);
    Ring<Event, AudioMemory> events = match (give back) {
        case Ok(value: r): give r;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    // The destination is the context's own node, at the slot past the table's rows: a program never makes it, and
    // nothing releases it, so it takes no row. Every part kept by slot has a slot for it.
    isize slots = nodeCapacity + 1;
    int64 destination = FIRST_GENERATION_ID + cast<int64>(nodeCapacity);
    Result<Connections, CapacityError> made =
        Connections.withCapacity(memory: memory, nodes: slots, connections: connectionCapacity);
    Connections links = match (give made) {
        case Ok(value: l): give l;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    // A node carries at most the declared channels, and at least the destination's (decision 38).
    int32 capacity = channelCapacity > channels ? channelCapacity : channels;
    Result<Engine, AudioError> audio = engineFrom(memory: memory, slots: slots, connectionCapacity: connectionCapacity,
                                                  channels: channels, capacity: capacity, destination: destination);
    // The engine is bound before the `try new`, never built in its argument list: a box with no room drops what it was
    // given from a local, and leaks a temporary built there (KAMA_GAPS.md KAUD-10).
    Engine engine = match (give audio) {
        case Ok(value: a): give a;
        case Err(error: e): { return Result::Err(error: e); }
    };
    Result<Shared<Samples, AudioMemory>, AudioError> drawn = samplesFrom(memory: memory, channels: channels, frames: length,
                                                                         sampleRate: sampleRate);
    Shared<Samples, AudioMemory> output = match (give drawn) {
        case Ok(value: o): give o;
        case Err(error: e): { return Result::Err(error: e); }
    };
    Result<Slots<int64, AudioMemory>, CapacityError> held = Slots::<int64, AudioMemory>.take(allocator: memory, capacity: suspendCapacity);
    Slots<int64, AudioMemory> suspends = match (give held) {
        case Ok(value: s): give s;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Slots<uint8, AudioMemory>, CapacityError> kept = Slots::<uint8, AudioMemory>.take(allocator: memory, capacity: nodeCapacity);
    Slots<uint8, AudioMemory> sources = match (give kept) {
        case Ok(value: k): give k;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Optional<Shared<ContextState, AudioMemory>> state =
        try new(allocator: memory) ContextState.make(nodes: give nodes, commands: give commands, waiting: give waiting,
                                                     events: give events, links: give links, engine: give engine,
                                                     output: give output, suspends: give suspends,
                                                     sources: give sources, destination: destination,
                                                     framesPerUpdate: framesPerUpdate,
                                                     sampleRate: sampleRate);
    return match (give state) {
        case Some(value: s): Result::Ok(value: give s);
        case None: Result::Err(error: AudioError::OutOfMemory);
    };
}

// What a node's `linkFor` answers: its context's state, by address, and its id. Only the package reads it.
type value NodeLink {
    public UnsafeConstPtr<ContextState> state = null;
    public int64 id = 0;

    public unsafe ctor make(UnsafeConstPtr<ContextState> state, int64 id) {
        this.state = state;
        this.id = id;
    }
}

type value ContextKey {
    friend NodeHold[mint];
    friend ContextState[mint];

    ctor mint() { }
}

type resource NodeHold implements Copyable<This>(bare: give) {
    Shared<ContextState, AudioMemory> state;
    int64 row = 0;

    private ctor adopt(Shared<ContextState, AudioMemory> state, int64 row) {
        this.state = give state;
        this.row = row;
    }

    // A row in `context`'s table, counted once, with its `Made` command sent. `TooManyCommands` when the backlog is
    // full, or `TooManyNodes` when every row is held, and then nothing changes.
    public ctor Result<NodeHold, AudioError> take(BaseAudioContext context, NodeKind kind) {
        ContextKey key = ContextKey.mint();
        Shared<ContextState, AudioMemory> state = context.stateFor(key: key);
        // The backlog's room is checked before a row is taken, so the make's command is sure to fit, and a refusal
        // leaves the table as it was.
        if (!state.canSend()) { return Result::Err(error: AudioError::TooManyCommands); }
        Optional<int64> taken = state.takeRow();
        int64 id = match (taken) { case Some(value: v): v; case None: 0; };
        if (id == 0) { return Result::Err(error: AudioError::TooManyNodes); }   // no live id is 0 (decision 34)
        bool sent = state.send(command: Command::Made(node: id, kind: kind));
        return Result::Ok(value: NodeHold.adopt(state: give state, row: id));
    }

    public ctor copy(ref NodeHold source) {
        this.state = copy source.state;
        this.row = source.row;
        bool counted = this.state.countUp(id: this.row);
    }

    // The id of the node's row: its slot and generation (decision 34).
    public const fn int64 id() { return this.row; }

    // The node's context and id, as `AudioNode.linkFor` answers them.
    public unsafe const fn NodeLink link() { return NodeLink.make(state: this.state.where(), id: this.row); }

    // Starts this source at `startTime` (`ContextState.startSource`).
    public fn Result<Unit, AudioError> start(float64 startTime) { return this.state.startSource(node: this.row, startTime: startTime); }

    // Connects this node's output to `destination`'s input (`AudioNode.connect`, `ContextState.connectFrom`).
    public unsafe fn Result<Unit, AudioError> connect(AudioNode destination) {
        return this.state.connectFrom(from: this.row, destination: destination);
    }

    ~NodeHold() { bool counted = this.state.countDown(id: this.row); }
}
