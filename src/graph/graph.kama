// audio::graph, the parts a context and every node made from it share (decisions 4, 9, 34, 35 and 36), and the audio
// side they drive (`engine.kama`). The module is internal: the package's own modules import it, and no program can.
//
// - **`ContextState`** is what a context's handles share: the program side's slot table, whose rows count the nodes
//   (decision 34), the backlog every call's command waits in and the ring a flush moves it into (decisions 7, 8 and
//   33), the way back the audio side reports on (decision 9), the audio side itself, and the context's fixed
//   properties. `stateFrom` draws its parts from the program's memory (decision 36), the state itself one block made
//   by `try new`, all freed with the last hold, the context's or a node's. Its `poll()` reads the way back and gives
//   each freed node's row back to the table.
// - **`NodeHold`** is a node's hold on its context's state and on its row: a copy counts the row up, a drop counts it
//   down, and the last drop marks the row for release (decision 35). The audio thread never touches a count
//   (decision 4).
// - **`ContextKey`** is what `BaseAudioContext.stateFor` asks for, so only `NodeHold.take` can reach a context's state.
// - **`Command`** is what a call sends the audio side (decisions 7, 32 and 33): a flat, typed value naming its node by
//   the id of its row, never by a pointer.

import { audio::AudioMemory, audio::AudioError, audio::BaseAudioContext, audio::rt::SlotTable, audio::rt::SlotArray,
         audio::rt::Ring, audio::rt::Backlog, audio::rt::CapacityError, audio::rt::slotOf, audio::rt::generationOf,
         std::memory::Shared, Engine, EngineNode, Event };

export { ContextState, NodeHold, ContextKey, Command, NodeKind, stateFrom };

// The kind of node a `Made` command makes.
type enum NodeKind {
    Gain;

    public const fn string name() { return match (this) { case Gain: "gain"; }; }
}

// A call's command (decision 7): flat bytes, so it crosses a ring or a transferred buffer as it is, and typed, so the
// audio side applies each kind by name. A node is named by its row's id, its slot and generation (decision 34).
type enum Command {
    Made(int64 node, NodeKind kind),
    Release(int64 node);

    // The command as text, for a test's or a log's reading: `made gain 0:1`, `release 0:1`, each node as its slot and
    // generation.
    public const fn string describe() {
        return match (this) {
            case Made(node: n, kind: k): {
                string what = k.name();
                int64 slot = slotOf(id: n);
                int64 generation = generationOf(id: n);
                return "made ${what} ${slot}:${generation}";
            }
            case Release(node: n): {
                int64 slot = slotOf(id: n);
                int64 generation = generationOf(id: n);
                return "release ${slot}:${generation}";
            }
        };
    }
}

type resource ContextState {
    SlotTable<AudioMemory> nodes;
    Backlog<Command, AudioMemory> waiting;
    Ring<Command, AudioMemory> commands;
    Ring<Event, AudioMemory> events;
    Engine engine;
    float32 rate = 0;

    public ctor make(SlotTable<AudioMemory> nodes, Ring<Command, AudioMemory> commands,
                     Backlog<Command, AudioMemory> waiting, Ring<Event, AudioMemory> events, Engine engine,
                     float32 sampleRate) {
        this.nodes = give nodes;
        this.commands = give commands;
        this.waiting = give waiting;
        this.events = give events;
        this.engine = give engine;
        this.rate = sampleRate;
    }

    public const fn float32 sampleRate() { return this.rate; }

    // A row for a new node, counted once, or `None` when every row is held.
    public fn Optional<int64> takeRow() { return this.nodes.take(); }

    // A copy of the node `id` names.
    public fn bool countUp(int64 id) { return this.nodes.countUp(id: id); }

    // A drop of the node `id` names; the last marks its row for release.
    public fn bool countDown(int64 id) { return this.nodes.countDown(id: id); }

    // The id of the node dropped longest ago whose release is due (decision 35), or `None`.
    public fn Optional<int64> nextRelease() { return this.nodes.nextRelease(); }

    // The rows held: nodes the program holds, and nodes dropped whose rows the audio side has not freed.
    public const fn isize rowsHeld() { return this.nodes.length(); }

    // Whether the backlog has room for one more command.
    public const fn bool canSend() { return this.waiting.length() < this.waiting.capacity(); }

    // Adds `command` behind the backlog's. False when the backlog is full, and then nothing is added.
    public fn bool send(Command command) { return this.waiting.add(item: command); }

    // The flush (decision 33): the backlog's commands moved into the ring, then, once the backlog has drained, the due
    // releases while the ring has room (decision 35), all published with one store. Answers how many it sent.
    // - A release goes only behind a drained backlog, so it never overtakes a command added before its node's last drop.
    //   With the ring drained on another thread, room can open between the move and the releases, so this is checked,
    //   not inferred from the room.
    // - A release is taken from the table only when the ring has room for it, so none is handed over and not sent: a
    //   row stays marked, and its release due, until a flush has room.
    public fn isize flush() {
        isize sent = this.waiting.stageInto(ring: this.commands);
        if (this.waiting.length() == 0) {
            bool more = true;
            while (more && this.commands.room() > 0) {
                Optional<int64> due = this.nodes.nextRelease();
                match (due) {
                    case Some(value: id): {
                        bool staged = this.commands.stage(item: Command::Release(node: id));
                        sent = sent + 1;
                    }
                    case None: { more = false; }
                };
            }
        }
        this.commands.publish();
        return sent;
    }

    // The audio side's next command from the ring, or `None` when it holds none published. An offline render takes its
    // commands on the program's thread; a real-time context's audio side reads the same ring.
    public fn Optional<Command> nextCommand() { return this.commands.pop(); }

    // One render quantum on the audio side, which an offline render runs on the program's thread: the commands the
    // flushes published, applied, and their reports published on the way back. Answers how many it applied.
    public fn isize renderQuantum() { return this.engine.renderQuantum(commands: this.commands, events: this.events); }

    // The way back read (decision 9): each report the audio side published, in the order it made them. A node freed
    // gives its row back to the table, which reuses it at the next generation (decision 34). Answers how many rows came
    // back.
    public fn isize poll() {
        isize freed = 0;
        bool more = true;
        while (more) {
            Optional<Event> got = this.events.pop();
            match (got) {
                case Some(value: e): {
                    match (e) {
                        case Freed(node: id): {
                            if (this.nodes.free(id: id)) { freed = freed + 1; }
                        }
                    };
                }
                case None: { more = false; }
            };
        }
        return freed;
    }

    // How many nodes the audio side holds.
    public const fn isize audioHeld() { return this.engine.held(); }

    // How many commands the audio side has refused.
    public const fn int64 refused() { return this.engine.refused(); }
}

// A context's state drawn from `memory` (decision 36), each part only once the one before it fit: its slot table of
// `nodeCapacity` rows, its command ring of `ringCapacity`, its backlog of `backlogCapacity`, the way back and the audio
// side's array, each of `nodeCapacity` (decision 9: a report for every row at once), then the block that holds them.
// A part with no room is `OutOfMemory`, and every part taken before it goes back when this returns.
fn Result<Shared<ContextState, AudioMemory>, AudioError> stateFrom(AudioMemory memory, isize nodeCapacity,
                                                                   isize ringCapacity, isize backlogCapacity,
                                                                   float32 sampleRate) {
    Result<SlotTable<AudioMemory>, CapacityError> table =
        SlotTable::<AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: nodeCapacity);
    SlotTable<AudioMemory> nodes = match (give table) {
        case Ok(value: t): give t;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Ring<Command, AudioMemory>, CapacityError> ring =
        Ring::<Command, AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: ringCapacity);
    Ring<Command, AudioMemory> commands = match (give ring) {
        case Ok(value: r): give r;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Backlog<Command, AudioMemory>, CapacityError> backlog =
        Backlog::<Command, AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: backlogCapacity);
    Backlog<Command, AudioMemory> waiting = match (give backlog) {
        case Ok(value: w): give w;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<Ring<Event, AudioMemory>, CapacityError> back =
        Ring::<Event, AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: nodeCapacity);
    Ring<Event, AudioMemory> events = match (give back) {
        case Ok(value: r): give r;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    Result<SlotArray<EngineNode, AudioMemory>, CapacityError> array =
        SlotArray::<EngineNode, AudioMemory>.withCapacityAndAllocator(allocator: memory, capacity: nodeCapacity);
    SlotArray<EngineNode, AudioMemory> audioNodes = match (give array) {
        case Ok(value: a): give a;
        case Err(error: e): { return Result::Err(error: AudioError::OutOfMemory); }
    };
    // The engine is bound before the `try new`, never built in its argument list: a box with no room drops what it was
    // given from a local, and leaks a temporary built there (KAMA_GAPS.md KAUD-10).
    Engine engine = Engine.make(nodes: give audioNodes);
    Optional<Shared<ContextState, AudioMemory>> state =
        try new(allocator: memory) ContextState.make(nodes: give nodes, commands: give commands, waiting: give waiting,
                                                     events: give events, engine: give engine, sampleRate: sampleRate);
    return match (give state) {
        case Some(value: s): Result::Ok(value: give s);
        case None: Result::Err(error: AudioError::OutOfMemory);
    };
}

type value ContextKey {
    friend NodeHold[mint];

    ctor mint() { }
}

type resource NodeHold implements Copyable<This>(bare: give) {
    Shared<ContextState, AudioMemory> state;
    int64 row = 0;

    private ctor adopt(Shared<ContextState, AudioMemory> state, int64 row) {
        this.state = give state;
        this.row = row;
    }

    // A row in `context`'s table, counted once, with its `Made` command sent. `TooManyCommands` when the backlog is
    // full, or `TooManyNodes` when every row is held, and then nothing changes.
    public ctor Result<NodeHold, AudioError> take(BaseAudioContext context, NodeKind kind) {
        ContextKey key = ContextKey.mint();
        Shared<ContextState, AudioMemory> state = context.stateFor(key: key);
        // The backlog's room is checked before a row is taken, so the make's command is sure to fit, and a refusal
        // leaves the table as it was.
        if (!state.canSend()) { return Result::Err(error: AudioError::TooManyCommands); }
        Optional<int64> taken = state.takeRow();
        int64 id = match (taken) { case Some(value: v): v; case None: 0; };
        if (id == 0) { return Result::Err(error: AudioError::TooManyNodes); }   // no live id is 0 (decision 34)
        bool sent = state.send(command: Command::Made(node: id, kind: kind));
        return Result::Ok(value: NodeHold.adopt(state: give state, row: id));
    }

    public ctor copy(ref NodeHold source) {
        this.state = copy source.state;
        this.row = source.row;
        bool counted = this.state.countUp(id: this.row);
    }

    // The id of the node's row: its slot and generation (decision 34).
    public const fn int64 id() { return this.row; }

    ~NodeHold() { bool counted = this.state.countDown(id: this.row); }
}
