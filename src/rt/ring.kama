// audio::rt::Ring and audio::rt::Backlog, the command protocol's two halves (AUD-1; AGENTS.audio.md decisions 5 to 8,
// 33), audio::rt::SlotTable, the program side's table of slots with generations that a command names a node by
// (AUD-2; decisions 4, 34 and 35), and audio::rt::SlotArray, where the audio side keeps each node at its id's slot
// (decisions 4, 5 and 34). Every call's command is added to the backlog on the program's side; a flush moves as
// many as the ring has room for, and the audio side drains the ring at the top of each quantum. They are public because
// a program's own DSP, and the packages built on this one's public API, move data between those two threads, and name
// their own objects across it, the same way (decisions 31 and 34).
//
// **The ring: one producer, one consumer, and nothing between them that waits.**
// - **Its capacity is declared** (decision 6): fixed when it is made, never grown.
// - **Its storage comes from the allocator it is handed** (decision 6), the global heap by default. It is taken once,
//   on the program's side, and given back when the ring drops. The audio side never allocates (decision 5).
// - **A full ring refuses a push and keeps what it holds.** What does not fit waits in the backlog (decision 8), so
//   nothing is dropped and nothing blocks.
// - **What is staged is published at once.** The producer may stage several items, then publish them with one release
//   store, so the consumer sees all of them or none: a flush lands whole (decision 33). A push is one item staged and
//   published.
// - **Its counters are monotonic,** masked only at the array, so a capacity need not be a power of two.
// - **Each counter sits on its own 128-byte line** (the M4's line), and so does the producer's count of what it has
//   staged, so the two threads never share one. A release store publishes each side's counter, and an acquire load
//   reads the other's: RESEARCH.md § 6.1 found the M4 tearing commands when the pair was relaxed.
//
// **The backlog: the program's side's alone,** in front of the ring (decisions 8 and 33).
// - **Its capacity is declared, and its storage is taken the same way.** A full backlog refuses an add and keeps what
//   it holds, so the call that made the command can return an error, and nothing is lost.
// - **A flush moves what the ring has room for,** from the front, in order, and publishes it with one store. What is
//   left waits, in order, and goes first on the next flush. A move stages without publishing, so a caller can stage
//   more behind it and publish everything with the one store: a context's flush adds the due releases that way.
// - **It counts its high-water marks:** the most it has held at once, which its capacity must allow, and the most a
//   flush has left behind, which says by how much the ring was too small.
//
// An element is a `value`: flat bytes, with no destructor, so the audio side never drops what it pops.

import { audio::store::Slots, std::concurrent::Atomic, std::concurrent::MemoryOrder };

export { Ring, Backlog, SlotTable, SlotArray, CapacityError, slotOf, generationOf };

// Why a ring, a backlog or a slot table was not made.
type enum CapacityError implements Error {
    BadCapacity, OutOfMemory;

    public const fn string message() {
        return match (this) {
            case BadCapacity: "a declared capacity must be at least one, and a slot table's at most 2^32";
            case OutOfMemory: "the allocator had no room for the declared capacity";
        };
    }
}

type resource Ring<T: value, A: Allocator = GlobalAllocator> {
    Atomic<int64> head;
    InlineArray<uint8>#(120) padHead;
    int64 staged = 0;   // the producer's alone: written past `head`, not yet published
    InlineArray<uint8>#(120) padStaged;
    Atomic<int64> tail;
    InlineArray<uint8>#(120) padTail;
    Slots<T, A> slots;

    private ctor adopt(Slots<T, A> slots) {
        this.head = Atomic.make(value: 0);
        this.padHead = [0; (120)];
        this.staged = 0;
        this.padStaged = [0; (120)];
        this.tail = Atomic.make(value: 0);
        this.padTail = [0; (120)];
        this.slots = give slots;
    }

    // A ring of `capacity` elements on the global heap.
    public ctor Result<Ring<T, A>, CapacityError> withCapacity(isize capacity) when [A: default] {
        A allocator = A.default();
        return Ring::<T, A>.withCapacityAndAllocator(allocator: allocator, capacity: capacity);
    }

    // A ring of `capacity` elements whose storage comes from `allocator`, an `Arena`'s handle or the program's own.
    public ctor Result<Ring<T, A>, CapacityError> withCapacityAndAllocator(A allocator, isize capacity) {
        Result<Slots<T, A>, CapacityError> taken = Slots::<T, A>.take(allocator: allocator, capacity: capacity);
        return match (give taken) {
            case Ok(value: s): Result::Ok(value: Ring::<T, A>.adopt(slots: give s));
            case Err(error: e): Result::Err(error: e);
        };
    }

    // The producer's side, one item: staged and published at once, with anything staged before it. False when the ring
    // is full, counting what is staged, and then nothing is written and nothing is published.
    public fn bool push(T item) {
        if (!this.stage(item: item)) { return false; }
        this.publish();
        return true;
    }

    // The producer's side, a batch: writes `item` where the consumer cannot see it until `publish()`. False when the
    // ring is full, counting what is staged, and then nothing is written.
    public fn bool stage(T item) {
        int64 h = this.head.loadExplicit(order: MemoryOrder::Relaxed) + this.staged;
        int64 t = this.tail.loadExplicit(order: MemoryOrder::Acquire);
        if (h - t >= this.slots.count()) { return false; }
        this.slots[h] = item;
        this.staged = this.staged + 1;
        return true;
    }

    // Makes everything staged visible to the consumer, with one release store.
    public fn void publish() {
        if (this.staged == 0) { return; }
        int64 h = this.head.loadExplicit(order: MemoryOrder::Relaxed);
        this.head.storeExplicit(value: h + this.staged, order: MemoryOrder::Release);
        this.staged = 0;
    }

    // The consumer's side. `None` when the ring is empty. It allocates nothing and never waits.
    @noheap public fn Optional<T> pop() {
        int64 t = this.tail.loadExplicit(order: MemoryOrder::Relaxed);
        int64 h = this.head.loadExplicit(order: MemoryOrder::Acquire);
        if (t == h) { return Optional::None; }
        T item = this.slots[t];
        this.tail.storeExplicit(value: t + 1, order: MemoryOrder::Release);
        return Optional::Some(value: item);
    }

    // The producer's side: how many more items it can stage now, counting what is staged and what the consumer has not
    // popped. The consumer only ever adds to it, so a stage the room allows is never refused.
    public fn isize room() {
        int64 h = this.head.loadExplicit(order: MemoryOrder::Relaxed) + this.staged;
        int64 t = this.tail.loadExplicit(order: MemoryOrder::Acquire);
        return cast<isize>(this.slots.count() - (h - t));
    }

    // The capacity it was made with.
    public const fn isize capacity() { return cast<isize>(this.slots.count()); }
}

type resource Backlog<T: value, A: Allocator = GlobalAllocator> {
    Slots<T, A> slots;
    int64 front = 0;     // monotonic, like the ring's counters
    int64 back = 0;
    int64 mostHeld = 0;
    int64 mostLeftBehind = 0;

    private ctor adopt(Slots<T, A> slots) { this.slots = give slots; }

    // A backlog of `capacity` commands on the global heap.
    public ctor Result<Backlog<T, A>, CapacityError> withCapacity(isize capacity) when [A: default] {
        A allocator = A.default();
        return Backlog::<T, A>.withCapacityAndAllocator(allocator: allocator, capacity: capacity);
    }

    // A backlog of `capacity` commands whose storage comes from `allocator`.
    public ctor Result<Backlog<T, A>, CapacityError> withCapacityAndAllocator(A allocator, isize capacity) {
        Result<Slots<T, A>, CapacityError> taken = Slots::<T, A>.take(allocator: allocator, capacity: capacity);
        return match (give taken) {
            case Ok(value: s): Result::Ok(value: Backlog::<T, A>.adopt(slots: give s));
            case Err(error: e): Result::Err(error: e);
        };
    }

    // Adds `item` behind what the backlog holds. False when it is full, and then nothing is written.
    public fn bool add(T item) {
        if (this.back - this.front >= this.slots.count()) { return false; }
        this.slots[this.back] = item;
        this.back = this.back + 1;
        int64 held = this.back - this.front;
        if (held > this.mostHeld) { this.mostHeld = held; }
        return true;
    }

    // Moves as many as `ring` has room for, from the front, in order, staged and not yet published: the caller publishes
    // them, with anything it stages after them, in one store. Answers how many moved. What is left waits, in order,
    // ahead of anything added later.
    public fn isize stageInto(ref Ring<T, A> ring) {
        int64 moved = 0;
        bool room = true;
        while (room && this.front < this.back) {
            room = ring.stage(item: this.slots[this.front]);
            if (room) {
                this.front = this.front + 1;
                moved = moved + 1;
            }
        }
        int64 left = this.back - this.front;
        if (left > this.mostLeftBehind) { this.mostLeftBehind = left; }
        return cast<isize>(moved);
    }

    // Moves as many as `ring` has room for, from the front, in order, and publishes them with one release store. Answers
    // how many moved. What is left waits, in order, ahead of anything added later.
    public fn isize flushInto(ref Ring<T, A> ring) {
        isize moved = this.stageInto(ring: ring);
        ring.publish();
        return moved;
    }

    // How many it holds now.
    public const fn isize length() { return cast<isize>(this.back - this.front); }

    // How many it can hold: the capacity it was made with.
    public const fn isize capacity() { return cast<isize>(this.slots.count()); }

    // The most it has held at once: what its declared capacity must allow.
    public const fn isize highWater() { return cast<isize>(this.mostHeld); }

    // The most a flush has left behind: by how much the ring was too small.
    public const fn isize mostLeft() { return cast<isize>(this.mostLeftBehind); }
}

// ---- the slot table (AUD-2; decisions 4, 6, 34 and 35) --------------------------------------------------------------

// An id: a 32-bit slot in the low half and its 32-bit generation in the high half of one int64, the field a command
// names a node by (decision 34). Generations start at 1, so no live id is 0.
comptime int64 SLOT_BITS = 32;
comptime int64 SLOT_MASK = 4294967295;
comptime int64 FIRST_GENERATION = 1;
comptime int64 LAST_GENERATION = 4294967295;
comptime int64 MOST_SLOTS = 4294967296;
comptime int64 NONE = -1;

fn int64 idOf(int64 slot, int64 generation) {
    return truncate<int64>((cast<uint64>(generation) << SLOT_BITS) | cast<uint64>(slot));
}

// The slot an id names.
fn int64 slotOf(int64 id) { return cast<int64>(truncate<uint64>(id) & cast<uint64>(SLOT_MASK)); }

// The generation an id names.
fn int64 generationOf(int64 id) { return cast<int64>(truncate<uint64>(id) >> SLOT_BITS); }

// Where a row is in its life. A take makes a free row taken; its last drop marks it; its release, handed to the flush,
// leaves it released until the audio side's report frees it, or retires it when its generation is the last.
type enum RowState { Free, Taken, Marked, Released, Retired; }

// One slot's row: what the program side keeps of a node.
type value SlotRow {
    public int64 count = 0;          // the program's copies; 0 once the last is dropped
    public int64 generation = 1;
    public int64 next = -1;          // the next row in its chain, free or marked; NONE at the end
    public RowState state = RowState::Free;

    public ctor make(int64 generation, int64 next) {
        this.count = 0;
        this.generation = generation;
        this.next = next;
        this.state = RowState::Free;
    }
}

// **The program side's table of slots with generations** (decisions 4, 34 and 35). A node's handle names its row by
// an id, and only the id crosses to the audio side.
// - **Its capacity is declared,** at most 2^32 rows, and its storage is taken once from the allocator it is handed, as
//   the ring's is. Nothing is allocated per row.
// - **A row is counted here alone,** so the audio thread never touches a count: a copy counts up, a drop counts down.
// - **The last drop marks the row,** and `nextRelease()` hands the marked rows to the flush in the order they were
//   marked. The row stays taken until `free(id:)`, the audio side's report, gives it back.
// - **The free rows wait in the order they were freed,** a fresh table's in slot order, so a freed slot waits longest
//   before its reuse. It comes back at the next generation; a slot whose generation would wrap is retired.
// - **An id that names no row in the state a call needs is refused** with `false`, `None` or a count of 0. Nothing a
//   program passes ends it.
type resource SlotTable<A: Allocator = GlobalAllocator> {
    Slots<SlotRow, A> rows;
    int64 freeHead = -1;
    int64 freeTail = -1;
    int64 markedHead = -1;
    int64 markedTail = -1;
    int64 held = 0;       // rows taken, marked or released
    int64 gone = 0;       // rows retired

    // The package's one test seam: the tests program's wrap case sets a free row's generation near the top, since four
    // billion reuses are too many for the gate.
    friend audiotests::ageSlot[ageTo];

    private ctor adopt(Slots<SlotRow, A> rows) {
        this.rows = give rows;
        int64 n = this.rows.count();
        int64 i = 0;
        while (i < n) {
            this.rows[i] = SlotRow.make(generation: FIRST_GENERATION, next: i + 1 < n ? i + 1 : NONE);
            i = i + 1;
        }
        this.freeHead = 0;
        this.freeTail = n - 1;
        this.markedHead = NONE;
        this.markedTail = NONE;
    }

    // A table of `capacity` rows on the global heap.
    public ctor Result<SlotTable<A>, CapacityError> withCapacity(isize capacity) when [A: default] {
        A allocator = A.default();
        return SlotTable::<A>.withCapacityAndAllocator(allocator: allocator, capacity: capacity);
    }

    // A table of `capacity` rows whose storage comes from `allocator`. More rows than a 32-bit slot can name are
    // refused as `BadCapacity`, before the allocator is asked.
    public ctor Result<SlotTable<A>, CapacityError> withCapacityAndAllocator(A allocator, isize capacity) {
        if (cast<int64>(capacity) > MOST_SLOTS) { return Result::Err(error: CapacityError::BadCapacity); }
        Result<Slots<SlotRow, A>, CapacityError> taken = Slots::<SlotRow, A>.take(allocator: allocator, capacity: capacity);
        return match (give taken) {
            case Ok(value: r): Result::Ok(value: SlotTable::<A>.adopt(rows: give r));
            case Err(error: e): Result::Err(error: e);
        };
    }

    // The row `id` names when it is in `state` at the id's generation, or NONE.
    private const fn int64 rowIn(int64 id, RowState state) {
        int64 slot = slotOf(id: id);
        if (slot >= this.rows.count()) { return NONE; }
        SlotRow row = this.rows[slot];
        if (row.state != state || row.generation != generationOf(id: id)) { return NONE; }
        return slot;
    }

    // Takes the row freed longest ago and answers its id, counted once. `None` when every row is held or retired, and
    // then nothing changes.
    public fn Optional<int64> take() {
        int64 slot = this.freeHead;
        if (slot == NONE) { return Optional::None; }
        this.freeHead = this.rows[slot].next;
        if (this.freeHead == NONE) { this.freeTail = NONE; }
        this.rows[slot].next = NONE;
        this.rows[slot].count = 1;
        this.rows[slot].state = RowState::Taken;
        this.held = this.held + 1;
        return Optional::Some(value: idOf(slot: slot, generation: this.rows[slot].generation));
    }

    // A copy of the handle `id` names: its row counted up. False when `id` names no taken row.
    public fn bool countUp(int64 id) {
        int64 slot = this.rowIn(id: id, state: RowState::Taken);
        if (slot == NONE) { return false; }
        this.rows[slot].count = this.rows[slot].count + 1;
        return true;
    }

    // A drop of the handle `id` names: its row counted down. The last drop marks the row, behind every row marked before
    // it. False when `id` names no taken row.
    public fn bool countDown(int64 id) {
        int64 slot = this.rowIn(id: id, state: RowState::Taken);
        if (slot == NONE) { return false; }
        this.rows[slot].count = this.rows[slot].count - 1;
        if (this.rows[slot].count == 0) {
            this.rows[slot].state = RowState::Marked;
            if (this.markedTail == NONE) { this.markedHead = slot; } else { this.rows[this.markedTail].next = slot; }
            this.markedTail = slot;
        }
        return true;
    }

    // The id of the row marked longest ago, whose release the flush sends now (decision 35). The row stays held until
    // the audio side's report frees it. `None` when no row is marked.
    public fn Optional<int64> nextRelease() {
        int64 slot = this.markedHead;
        if (slot == NONE) { return Optional::None; }
        this.markedHead = this.rows[slot].next;
        if (this.markedHead == NONE) { this.markedTail = NONE; }
        this.rows[slot].next = NONE;
        this.rows[slot].state = RowState::Released;
        return Optional::Some(value: idOf(slot: slot, generation: this.rows[slot].generation));
    }

    // The audio side's report that the node `id` names is gone: its row waits behind every row freed before it, at the
    // next generation, or is retired when its generation is the last. False when `id` names no row whose release was
    // sent.
    public fn bool free(int64 id) {
        int64 slot = this.rowIn(id: id, state: RowState::Released);
        if (slot == NONE) { return false; }
        this.held = this.held - 1;
        if (this.rows[slot].generation == LAST_GENERATION) {
            this.rows[slot].state = RowState::Retired;
            this.gone = this.gone + 1;
            return true;
        }
        this.rows[slot].generation = this.rows[slot].generation + 1;
        this.rows[slot].state = RowState::Free;
        if (this.freeTail == NONE) { this.freeHead = slot; } else { this.rows[this.freeTail].next = slot; }
        this.freeTail = slot;
        return true;
    }

    // How many copies of the handle `id` names are held: 0 when `id` names no taken row.
    public const fn int64 countOf(int64 id) {
        int64 slot = this.rowIn(id: id, state: RowState::Taken);
        if (slot == NONE) { return 0; }
        return this.rows[slot].count;
    }

    // How many rows are held: taken, or dropped and not yet freed by the audio side.
    public const fn isize length() { return cast<isize>(this.held); }

    // How many rows it was made with.
    public const fn isize capacity() { return cast<isize>(this.rows.count()); }

    // How many slots are retired, their generations spent.
    public const fn isize retired() { return cast<isize>(this.gone); }

    private fn void ageTo(int64 slot, int64 generation) { this.rows[slot].generation = generation; }
}

// ---- the audio side's array of slots (AUD-2; decisions 4, 5, 34) ----------------------------------------------------

// One slot of a `SlotArray`: the generation its value was put at, or 0 while it holds none.
type value SlotCell<T: value> {
    public int64 generation = 0;
    public T value;
}

// **The audio side's array of slots** (decisions 4, 5 and 34): what the audio side keeps of each node the program side's
// `SlotTable` names, at the id's slot. The DAW and speech packages keep their own objects' audio-side state the same way.
// - **Its capacity is declared,** at most 2^32 slots, and its storage is taken once from the allocator it is handed, on
//   the program's side, as the ring's is. Nothing is allocated per value, so the audio thread never allocates
//   (decision 5).
// - **A value is put at the slot an id names, at the id's generation,** and only into an empty slot.
// - **A read, a set or a removal names the generation the value was put at.** An id of any other generation is
//   refused, so a command that names a node the audio side no longer holds never reaches the node now in its slot
//   (decision 34). `idAt(slot:)` answers the id a slot holds, so a walk over the slots visits every value.
// - **An id that names no slot of the array, or generation 0, is refused** with `false` or `None`, never a trap: no
//   live id has generation 0, which marks an empty slot.
type resource SlotArray<T: value, A: Allocator = GlobalAllocator> {
    Slots<SlotCell<T>, A> cells;
    int64 held = 0;

    private ctor adopt(Slots<SlotCell<T>, A> cells) {
        this.cells = give cells;
        int64 n = this.cells.count();
        int64 i = 0;
        while (i < n) {
            this.cells[i].generation = 0;
            i = i + 1;
        }
        this.held = 0;
    }

    // An array of `capacity` slots on the global heap.
    public ctor Result<SlotArray<T, A>, CapacityError> withCapacity(isize capacity) when [A: default] {
        A allocator = A.default();
        return SlotArray::<T, A>.withCapacityAndAllocator(allocator: allocator, capacity: capacity);
    }

    // An array of `capacity` slots whose storage comes from `allocator`. More slots than a 32-bit slot can name are
    // refused as `BadCapacity`, before the allocator is asked.
    public ctor Result<SlotArray<T, A>, CapacityError> withCapacityAndAllocator(A allocator, isize capacity) {
        if (cast<int64>(capacity) > MOST_SLOTS) { return Result::Err(error: CapacityError::BadCapacity); }
        Result<Slots<SlotCell<T>, A>, CapacityError> taken = Slots::<SlotCell<T>, A>.take(allocator: allocator, capacity: capacity);
        return match (give taken) {
            case Ok(value: c): Result::Ok(value: SlotArray::<T, A>.adopt(cells: give c));
            case Err(error: e): Result::Err(error: e);
        };
    }

    // The slot `id` names when it holds a value at the id's generation, or NONE.
    private const fn int64 cellOf(int64 id) {
        int64 slot = slotOf(id: id);
        int64 generation = generationOf(id: id);
        if (slot >= this.cells.count() || generation == 0) { return NONE; }
        if (this.cells[slot].generation != generation) { return NONE; }
        return slot;
    }

    // Puts `value` at the slot `id` names, at the id's generation. False when the slot already holds a value, or `id`
    // names no slot of the array or generation 0, and then nothing changes.
    public fn bool put(int64 id, T value) {
        int64 slot = slotOf(id: id);
        int64 generation = generationOf(id: id);
        if (slot >= this.cells.count() || generation == 0) { return false; }
        if (this.cells[slot].generation != 0) { return false; }
        this.cells[slot].value = value;
        this.cells[slot].generation = generation;
        this.held = this.held + 1;
        return true;
    }

    // The value at the slot `id` names, when it was put there at the id's generation; otherwise `None`.
    public const fn Optional<T> at(int64 id) {
        int64 slot = this.cellOf(id: id);
        if (slot == NONE) { return Optional::None; }
        return Optional::Some(value: this.cells[slot].value);
    }

    // Takes away the value `id` names, leaving its slot empty. False when the slot holds no value at the id's
    // generation, and then nothing changes.
    public fn bool remove(int64 id) {
        int64 slot = this.cellOf(id: id);
        if (slot == NONE) { return false; }
        this.cells[slot].generation = 0;
        this.held = this.held - 1;
        return true;
    }

    // Replaces the value `id` names with `value`, at the same generation. False when the slot holds no value at the
    // id's generation, and then nothing changes.
    public fn bool set(int64 id, T value) {
        int64 slot = this.cellOf(id: id);
        if (slot == NONE) { return false; }
        this.cells[slot].value = value;
        return true;
    }

    // The id of the value `slot` holds: the slot and the generation the value was put at. 0 when the slot holds none,
    // or is not a slot of the array. A walk over every slot visits every value this way.
    public const fn int64 idAt(int64 slot) {
        if (slot < 0 || slot >= this.cells.count()) { return 0; }
        int64 generation = this.cells[slot].generation;
        if (generation == 0) { return 0; }
        return idOf(slot: slot, generation: generation);
    }

    // How many slots hold a value.
    public const fn isize length() { return cast<isize>(this.held); }

    // How many slots it was made with.
    public const fn isize capacity() { return cast<isize>(this.cells.count()); }
}
