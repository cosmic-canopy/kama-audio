// audio::store::Slots, the storage under every declared capacity (decisions 5 and 6). The module is internal: the
// package's own modules import it, and no program can.
//
// - **Taken once, at a make, on the program's side,** from the allocator a part is handed, as `capacity` elements, and
//   given back to it at the drop. Never grown, so the audio thread never allocates (decision 5).
// - **A make with no room answers `OutOfMemory`,** and a capacity below one `BadCapacity`, never a trap: std's
//   collections cannot serve here, since each traps when its allocator has no room (KAMA_GAPS.md KAUD-7).
// - **Its elements are not built:** each holder writes what it reads before it reads it.
// - The ring, the backlog, the slot table and the slot array hold one each, and so do the parts of `audio::graph`.

import { audio::rt::CapacityError };

export { Slots };

// Storage for a declared number of elements, taken once from an allocator and given back to it at the drop.
type resource Slots<T: value, A: Allocator> {
    UnsafePtr<T> data = null;
    int64 cap = 0;
    A alloc;

    private unsafe ctor adopt(UnsafePtr<T> data, int64 capacity, A allocator) {
        this.data = data;
        this.cap = capacity;
        this.alloc = allocator;
    }

    public unsafe ctor Result<Slots<T, A>, CapacityError> take(A allocator, isize capacity) {
        if (capacity < 1) { return Result::Err(error: CapacityError::BadCapacity); }
        usize bytes = cast<usize>(capacity) * sizeof(T);
        Optional<UnsafePtr> got = allocator.allocate(bytes: bytes, align: alignof(T));
        return match (got) {
            case Some(value: p): Result::Ok(value: Slots::<T, A>.adopt(data: cast<UnsafePtr<T>>(p), capacity: cast<int64>(capacity),
                                                                allocator: allocator));
            case None: Result::Err(error: CapacityError::OutOfMemory);
        };
    }

    // The element a monotonic counter `at` names: the counter masked at the array.
    @noheap public unsafe ref T operator[](int64 at) { return this.data[cast<isize>(at % this.cap)]; }

    public const fn int64 count() { return this.cap; }

    unsafe ~Slots() {
        if (this.data != null) {
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.data), bytes: cast<usize>(this.cap) * sizeof(T),
                                  align: alignof(T));
        }
    }
}
