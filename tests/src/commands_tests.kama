// commands: what a call sends the audio side (AUD-1 over AUD-2's handle; AGENTS.audio.md decisions 7, 8, 33 and 35).
// - A make adds its command to the context's backlog, and only a flush moves it into the ring.
// - A flush lands whole: the backlog's commands, in the order the calls were made, then, once the backlog has drained,
//   the due releases in the order the last drops were made, all published with one store.
// - A release is never refused and never overtakes a command that names its node: it waits while the ring is full, and
//   is sent once.
// - A full backlog refuses a make with `TooManyCommands`, and nothing changes (decision 8).
// The tests read the ring as the audio side would, through the package's seam (`friend` grants in `src/context.kama`),
// each command as text: `made gain 0:1` is a gain made at slot 0, generation 1.

import { Tally, named, letGo, rowsHeldIn, audio::OfflineAudioContext, audio::OfflineAudioContextOptions,
         audio::AudioError, audio::GainNode };

export { commandsTests, flushIn, sentIn, CommandsCase, withCommands, gainIn, letGoOf, flushSends };

// The package's seam into a context: a flush, and the next command the audio side would take from the ring.
fn isize flushIn(ref OfflineAudioContext context) { return context.flush(); }

fn Optional<string> sentIn(ref OfflineAudioContext context) { return context.sent(); }

// ---- helpers ----------------------------------------------------------------------------------------------------------

fn string expectSent(ref OfflineAudioContext context, const ref string want) {
    Optional<string> got = sentIn(context: context);
    return match (got) {
        case Some(value: text): text == want ? "" : "the ring gave `${text}` where `${want}` was due";
        case None: "the ring was empty where `${want}` was due";
    };
}

fn string expectNothingSent(ref OfflineAudioContext context) {
    Optional<string> got = sentIn(context: context);
    return match (got) {
        case Some(value: text): "the ring gave `${text}` where nothing was due";
        case None: "";
    };
}

fn string flushSends(ref OfflineAudioContext context, isize want) {
    isize sent = flushIn(context: context);
    return sent == want ? "" : "a flush sent ${sent} commands where ${want} were due";
}

// A gain node made in `context`, or `None` when the make was refused.
fn Optional<GainNode> gainIn(ref OfflineAudioContext context) {
    Result<GainNode, AudioError> made = GainNode.make(context: context);
    return match (give made) {
        case Ok(value: n): Optional::Some(value: give n);
        case Err(error: e): Optional::None;
    };
}

// The end of a node held in an Optional: it is moved in, and dropped when this returns.
fn void letGoOf(Optional<GainNode> node) { }

fnptr string CommandsCase(ref OfflineAudioContext context);

// Runs `body` on a fresh context of `nodes` rows, a ring of `ring` and a backlog of `backlog`, on the global heap.
fn void withCommands(ref Tally t, const ref string name, isize nodes, isize ring, isize backlog, CommandsCase body) {
    OfflineAudioContextOptions o = OfflineAudioContextOptions.make(length: 128, sampleRate: 48000);
    o.nodeCapacity = nodes;
    o.ringCapacity = ring;
    o.backlogCapacity = backlog;
    Result<OfflineAudioContext, AudioError> made = OfflineAudioContext.make(options: o);
    match (give made) {
        case Ok(value: c0): {
            OfflineAudioContext context = give c0;
            string why = body(context: context);
            t.verdict(name: name, why: why);
        }
        case Err(error: e): {
            string m = e.message();
            t.verdict(name: name, why: "the context was not made: ${m}");
        }
    };
}

// ---- the cases --------------------------------------------------------------------------------------------------------

// A make adds its command to the backlog: nothing reaches the ring until a flush, which sends it once.
fn string makeSends(ref OfflineAudioContext context) {
    Optional<GainNode> a = gainIn(context: context);
    if (!a.isSome()) { return "the node was refused"; }
    string early = expectNothingSent(context: context);
    if (!early.isEmpty()) { return "before the flush: ${early}"; }
    string why = flushSends(context: context, want: 1);
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 0:1");
    if (!why.isEmpty()) { return why; }
    why = expectNothingSent(context: context);
    if (!why.isEmpty()) { return why; }
    return flushSends(context: context, want: 0);
}

// A flush sends the backlog's commands in the order the calls were made.
fn string inOrder(ref OfflineAudioContext context) {
    Optional<GainNode> a = gainIn(context: context);
    Optional<GainNode> b = gainIn(context: context);
    Optional<GainNode> c = gainIn(context: context);
    if (!a.isSome() || !b.isSome() || !c.isSome()) { return "a node was refused"; }
    string why = flushSends(context: context, want: 3);
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 0:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 1:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 2:1");
    if (!why.isEmpty()) { return why; }
    return expectNothingSent(context: context);
}

// A copy's drop sends nothing; each last drop's release goes after everything the backlog held, in the order the last
// drops were made, in the same flush.
fn string releasesAfter(ref OfflineAudioContext context) {
    Optional<GainNode> a = gainIn(context: context);
    Optional<GainNode> b = gainIn(context: context);
    if (!b.isSome()) { return "the second node was refused"; }
    match (give a) {
        case Some(value: na): {
            GainNode other = copy na;
            letGo(node: give other);
            letGoOf(node: give b);
            letGo(node: give na);
        }
        case None: { return "the first node was refused"; }
    };
    string why = flushSends(context: context, want: 4);
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 0:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 1:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "release 1:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "release 0:1");
    if (!why.isEmpty()) { return why; }
    why = expectNothingSent(context: context);
    if (!why.isEmpty()) { return why; }
    return flushSends(context: context, want: 0);
}

// A ring of 2 takes two of three makes; a release waits behind the make the backlog still holds, though that make was
// added before the drop, and goes with it on the next flush.
fn string releaseWaits(ref OfflineAudioContext context) {
    Optional<GainNode> a = gainIn(context: context);
    Optional<GainNode> b = gainIn(context: context);
    Optional<GainNode> c = gainIn(context: context);
    if (!a.isSome() || !b.isSome() || !c.isSome()) { return "a node was refused"; }
    letGoOf(node: give a);
    string why = flushSends(context: context, want: 2);
    if (!why.isEmpty()) { return "the first flush: ${why}"; }
    why = expectSent(context: context, want: "made gain 0:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 1:1");
    if (!why.isEmpty()) { return why; }
    why = expectNothingSent(context: context);
    if (!why.isEmpty()) { return why; }
    why = flushSends(context: context, want: 2);
    if (!why.isEmpty()) { return "the second flush: ${why}"; }
    why = expectSent(context: context, want: "made gain 2:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "release 0:1");
    if (!why.isEmpty()) { return why; }
    return expectNothingSent(context: context);
}

// A ring with no room keeps a release due: the row stays held, and the release goes on a later flush, once.
fn string fullRingKeepsRelease(ref OfflineAudioContext context) {
    Optional<GainNode> a = gainIn(context: context);
    if (!a.isSome()) { return "the node was refused"; }
    string why = flushSends(context: context, want: 1);
    if (!why.isEmpty()) { return "the make's flush: ${why}"; }
    letGoOf(node: give a);
    why = flushSends(context: context, want: 0);
    if (!why.isEmpty()) { return "a flush into a full ring: ${why}"; }
    isize held = rowsHeldIn(context: context);
    if (held != 1) { return "the dropped node's row was not held while its release waited: ${held} rows held"; }
    why = expectSent(context: context, want: "made gain 0:1");
    if (!why.isEmpty()) { return why; }
    why = expectNothingSent(context: context);
    if (!why.isEmpty()) { return "the release was published into a full ring: ${why}"; }
    why = flushSends(context: context, want: 1);
    if (!why.isEmpty()) { return "the flush once the ring had room: ${why}"; }
    why = expectSent(context: context, want: "release 0:1");
    if (!why.isEmpty()) { return why; }
    why = flushSends(context: context, want: 0);
    if (!why.isEmpty()) { return "the release was sent twice: ${why}"; }
    return expectNothingSent(context: context);
}

// A full backlog refuses a make with TooManyCommands, before a row is taken, and nothing changes: no row, no command,
// no release. A flush makes room, and the make is taken.
fn string fullBacklog(ref OfflineAudioContext context) {
    Optional<GainNode> a = gainIn(context: context);
    Optional<GainNode> b = gainIn(context: context);
    if (!a.isSome() || !b.isSome()) { return "a node was refused with the backlog not full"; }
    Result<GainNode, AudioError> third = GainNode.make(context: context);
    match (give third) {
        case Ok(value: n): { return "a backlog of 2 took a third make"; }
        case Err(error: e): {
            string got = named(e: e);
            if (got != "TooManyCommands") { return "the third make answered ${got} where TooManyCommands was due"; }
        }
    };
    isize held = rowsHeldIn(context: context);
    if (held != 2) { return "the refused make left ${held} rows held where 2 were due"; }
    string why = flushSends(context: context, want: 2);
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 0:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 1:1");
    if (!why.isEmpty()) { return why; }
    why = expectNothingSent(context: context);
    if (!why.isEmpty()) { return "the refused make sent something: ${why}"; }
    Optional<GainNode> c = gainIn(context: context);
    if (!c.isSome()) { return "a make was refused after a flush emptied the backlog"; }
    why = flushSends(context: context, want: 1);
    if (!why.isEmpty()) { return why; }
    return expectSent(context: context, want: "made gain 2:1");
}

// With both the backlog and the table full, the backlog answers first, since it is checked before a row is taken; once
// a flush empties it, the table answers.
fn string bothFull(ref OfflineAudioContext context) {
    Optional<GainNode> a = gainIn(context: context);
    Optional<GainNode> b = gainIn(context: context);
    if (!a.isSome() || !b.isSome()) { return "a node was refused with room for it"; }
    Result<GainNode, AudioError> third = GainNode.make(context: context);
    match (give third) {
        case Ok(value: n): { return "a full context took a third make"; }
        case Err(error: e): {
            string got = named(e: e);
            if (got != "TooManyCommands") { return "with both full, the make answered ${got} where TooManyCommands was due"; }
        }
    };
    string why = flushSends(context: context, want: 2);
    if (!why.isEmpty()) { return why; }
    Result<GainNode, AudioError> fourth = GainNode.make(context: context);
    match (give fourth) {
        case Ok(value: n): { return "a full table took a make"; }
        case Err(error: e): {
            string got = named(e: e);
            if (got != "TooManyNodes") { return "with the table full, the make answered ${got} where TooManyNodes was due"; }
        }
    };
    return "";
}

// The options declare a ring of 1,024 and a backlog of 4,096 by default, beside the table's 1,024 rows.
fn string defaults() {
    OfflineAudioContextOptions o = OfflineAudioContextOptions.make(length: 128, sampleRate: 48000);
    isize nodes = o.nodeCapacity;
    isize ring = o.ringCapacity;
    isize backlog = o.backlogCapacity;
    return nodes == 1024 && ring == 1024 && backlog == 4096 ? ""
        : "the defaults were ${nodes} nodes, a ring of ${ring} and a backlog of ${backlog}";
}

fn void commandsTests(ref Tally t) {
    t.verdict(name: "commands: the options declare a ring of 1,024 and a backlog of 4,096 by default", why: defaults());
    withCommands(t: t, name: "commands: a make adds its command to the backlog, and only a flush sends it, once",
                 nodes: 4, ring: 8, backlog: 8, body: makeSends);
    withCommands(t: t, name: "commands: a flush sends the backlog's commands in the order the calls were made",
                 nodes: 4, ring: 8, backlog: 8, body: inOrder);
    withCommands(t: t, name: "commands: a copy's drop sends nothing, and releases follow the backlog in the order of the last drops",
                 nodes: 4, ring: 8, backlog: 8, body: releasesAfter);
    withCommands(t: t, name: "commands: a release waits behind the commands the backlog still holds",
                 nodes: 4, ring: 2, backlog: 8, body: releaseWaits);
    withCommands(t: t, name: "commands: a ring with no room keeps a release due, sent on a later flush once",
                 nodes: 4, ring: 1, backlog: 8, body: fullRingKeepsRelease);
    withCommands(t: t, name: "commands: a full backlog refuses a make with TooManyCommands, and nothing changes",
                 nodes: 4, ring: 8, backlog: 2, body: fullBacklog);
    withCommands(t: t, name: "commands: with the backlog and the table full, the backlog answers first",
                 nodes: 2, ring: 8, backlog: 2, body: bothFull);
}
