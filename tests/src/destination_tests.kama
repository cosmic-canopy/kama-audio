// destination: Web Audio's `AudioDestinationNode`, and the order the render runs a context's nodes in (AUD-29;
// AGENTS.audio.md decisions 3, 4, 6 and 37; Web Audio's `destination`, its rendering algorithm's ordered node list, and
// its muting of a cycle with no DelayNode).
// - Every context has a destination, made with it: `context.destination()`, Web Audio's `destination`. Its channel
//   count is the context's. It takes no row in the program side's table, and nothing releases it: the audio side keeps
//   it from the make, at the slot past the table's rows.
// - A node connects to it, and it connects onward, as any node does, within its own context.
// - The render's order holds every node the audio side holds, each after every node that feeds it, whether or not it
//   reaches the destination. A node in a cycle with no delay is muted and left out, the destination too. A make, a
//   connect and a free each re-order it.
// The tests read the order a position at a time, and a node's muting, through the package's seam.

import { Tally, named, letGo, idAt, quantumApplies, audioHolds, pollFrees, rowsHeld, refusedSoFar, flushSends,
         expectSent, expectNothingSent, releaseDueIn, withLinks, taken, refusedAs, lands, audio::OfflineAudioContext,
         audio::OfflineAudioContextOptions, audio::AudioError, audio::GainNode, audio::AudioDestinationNode };

export { destinationTests, orderAtIn, mutedIn };

// The package's seam into a context: the node at a position in the render's order, and whether a node is muted.
fn Optional<int64> orderAtIn(ref OfflineAudioContext context, int64 position) { return context.orderAt(position: position); }

fn bool mutedIn(ref OfflineAudioContext context, int64 node) { return context.muted(node: node); }

// ---- helpers ----------------------------------------------------------------------------------------------------------

// The order holds at most every node a case makes; a longer one is the package's bug, not a reason to hang.
comptime int64 LONGEST = 64;

// Where `node` is in the render's order, or -1 when it is not in it.
fn int64 positionOf(ref OfflineAudioContext context, int64 node) {
    int64 at = 0;
    while (at < LONGEST) {
        Optional<int64> got = orderAtIn(context: context, position: at);
        match (got) {
            case Some(value: id): { if (id == node) { return at; } }
            case None: { return -1; }
        };
        at = at + 1;
    }
    return -1;
}

// How many nodes the render's order holds.
fn int64 orderLength(ref OfflineAudioContext context) {
    int64 at = 0;
    while (at < LONGEST) {
        Optional<int64> got = orderAtIn(context: context, position: at);
        if (!got.isSome()) { return at; }
        at = at + 1;
    }
    return at;
}

fn string orderHolds(ref OfflineAudioContext context, int64 want) {
    int64 length = orderLength(context: context);
    return length == want ? "" : "the order held ${length} nodes where ${want} were due";
}

// "" when `from` comes before `to` in the order, both in it.
fn string feedsBefore(ref OfflineAudioContext context, int64 from, int64 to, const ref string what) {
    int64 f = positionOf(context: context, node: from);
    int64 t = positionOf(context: context, node: to);
    if (f < 0) { return "${what}: the feeder was not in the order"; }
    if (t < 0) { return "${what}: the node it feeds was not in the order"; }
    return f < t ? "" : "${what}: the feeder came at ${f}, after the node it feeds at ${t}";
}

// "" when `node` is in the order and not muted.
fn string sounds(ref OfflineAudioContext context, int64 node, const ref string what) {
    if (mutedIn(context: context, node: node)) { return "${what} was muted"; }
    return positionOf(context: context, node: node) >= 0 ? "" : "${what} was not in the order";
}

// "" when `node` is muted and left out of the order.
fn string mutedOut(ref OfflineAudioContext context, int64 node, const ref string what) {
    if (!mutedIn(context: context, node: node)) { return "${what} was not muted"; }
    int64 at = positionOf(context: context, node: node);
    return at < 0 ? "" : "${what} was muted but in the order, at ${at}";
}

// The id of the gain made `n`th in a fresh context (slot n, generation 1), and of a context's destination, at the slot
// past its `nodes` rows.
fn int64 gainAt(int64 n) { return idAt(slot: n, generation: 1); }

fn int64 destinationOf(int64 nodes) { return idAt(slot: nodes, generation: 1); }

// The end of a destination's handle: it is moved in, and dropped when this returns.
fn void letGoOfDestination(AudioDestinationNode node) { }

// ---- the destination --------------------------------------------------------------------------------------------------

// Its channel count is the context's numberOfChannels, and so is the most it can be set to.
fn string channels() {
    InlineArray<int32>#(3) counts = [1, 6, 32];
    isize k = 0;
    while (k < 3) {
        int32 want = counts[k];
        OfflineAudioContextOptions o = OfflineAudioContextOptions.make(length: 128, sampleRate: 48000);
        o.numberOfChannels = want;
        o.nodeCapacity = 4;   // every slot's block carries the context's channels: 32 of them at 1,024 rows is 16 MiB
        Result<OfflineAudioContext, AudioError> made = OfflineAudioContext.make(options: o);
        OfflineAudioContext context = match (give made) {
            case Ok(value: c): give c;
            case Err(error: e): { string n = named(e: e); return "a context of ${want} channels was refused: ${n}"; }
        };
        AudioDestinationNode d = context.destination();
        int32 count = d.channelCount();
        int32 most = d.maxChannelCount();
        if (count != want || most != want) {
            return "a context of ${want} channels had a destination of ${count} channels, at most ${most}";
        }
        k = k + 1;
    }
    return "";
}

// A gain connects to the destination and the destination to a gain, each sent as a connection to or from the slot past
// the table's rows; the same connection made again sends nothing.
fn string connectsBothWays(ref OfflineAudioContext context) {
    AudioDestinationNode d = context.destination();
    Result<GainNode, AudioError> ra = GainNode.make(context: context);
    GainNode a = match (give ra) { case Ok(value: g): give g; case Err(error: e): { return "the gain was refused"; } };
    string why = taken(r: a.connect(destination: d), what: "a gain's connect to the destination");
    if (!why.isEmpty()) { return why; }
    why = taken(r: d.connect(destination: a), what: "the destination's connect to a gain");
    if (!why.isEmpty()) { return why; }
    why = taken(r: a.connect(destination: d), what: "the same connect to the destination again");
    if (!why.isEmpty()) { return why; }
    why = taken(r: d.connect(destination: a), what: "the same connect from the destination again");
    if (!why.isEmpty()) { return why; }
    why = flushSends(context: context, want: 3);
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "made gain 0:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "connect 0:1 to 4:1");
    if (!why.isEmpty()) { return why; }
    why = expectSent(context: context, want: "connect 4:1 to 0:1");
    if (!why.isEmpty()) { return why; }
    return expectNothingSent(context: context);
}

// Another context's destination, or a node of another context, is refused as InvalidAccess both ways, and nothing is
// sent in either context.
fn string otherContext(ref OfflineAudioContext context) {
    OfflineAudioContextOptions o = OfflineAudioContextOptions.make(length: 128, sampleRate: 48000);
    o.nodeCapacity = 4;
    Result<OfflineAudioContext, AudioError> made = OfflineAudioContext.make(options: o);
    OfflineAudioContext other = match (give made) { case Ok(value: c): give c; case Err(error: e): { return "the other context was refused"; } };
    Result<GainNode, AudioError> rb = GainNode.make(context: other);
    GainNode b = match (give rb) { case Ok(value: g): give g; case Err(error: e): { return "the other context's gain was refused"; } };
    AudioDestinationNode d = context.destination();
    string why = refusedAs(r: b.connect(destination: d), want: "InvalidAccess", what: "another context's gain to this destination");
    if (!why.isEmpty()) { return why; }
    why = refusedAs(r: d.connect(destination: b), want: "InvalidAccess", what: "this destination to another context's gain");
    if (!why.isEmpty()) { return why; }
    AudioDestinationNode e = other.destination();
    why = refusedAs(r: d.connect(destination: e), want: "InvalidAccess", what: "this destination to another's");
    if (!why.isEmpty()) { return why; }
    why = flushSends(context: context, want: 0);
    if (!why.isEmpty()) { return "this context: ${why}"; }
    return flushSends(context: other, want: 1);
}

// The destination takes no row: a context of one node row makes one gain, and its connections to and from the
// destination land on the audio side, which refuses none. The audio side holds the gain, and its destination besides.
fn string noRow(ref OfflineAudioContext context) {
    AudioDestinationNode d = context.destination();
    string why = rowsHeld(context: context, want: 0);
    if (!why.isEmpty()) { return "with only the destination: ${why}"; }
    Result<GainNode, AudioError> ra = GainNode.make(context: context);
    GainNode a = match (give ra) { case Ok(value: g): give g; case Err(error: e): { string n = named(e: e); return "the gain was refused: ${n}"; } };
    Result<GainNode, AudioError> rb = GainNode.make(context: context);
    match (give rb) {
        case Ok(value: g): { return "a context of one node row made a second gain"; }
        case Err(error: e): {
            string n = named(e: e);
            if (n != "TooManyNodes") { return "a second gain answered ${n} where TooManyNodes was due"; }
        }
    };
    why = taken(r: a.connect(destination: d), what: "the gain's connect to the destination");
    if (!why.isEmpty()) { return why; }
    why = taken(r: d.connect(destination: a), what: "the destination's connect to the gain");
    if (!why.isEmpty()) { return why; }
    why = lands(context: context, sent: 3);
    if (!why.isEmpty()) { return why; }
    why = refusedSoFar(context: context, want: 0);
    if (!why.isEmpty()) { return why; }
    return audioHolds(context: context, want: 1);
}

// Nothing releases the destination: every handle dropped, it holds no row, no release is due or sent, and the audio
// side keeps it in the order.
fn string neverReleased(ref OfflineAudioContext context) {
    {
        AudioDestinationNode d = context.destination();
        AudioDestinationNode e = copy d;
        letGoOfDestination(node: give e);
    }
    string why = rowsHeld(context: context, want: 0);
    if (!why.isEmpty()) { return why; }
    Optional<int64> due = releaseDueIn(context: context);
    if (due.isSome()) { return "a release was due after the destination's handles were dropped"; }
    why = flushSends(context: context, want: 0);
    if (!why.isEmpty()) { return why; }
    why = quantumApplies(context: context, want: 0);
    if (!why.isEmpty()) { return why; }
    why = sounds(context: context, node: destinationOf(nodes: 4), what: "the destination");
    if (!why.isEmpty()) { return why; }
    return orderHolds(context: context, want: 1);
}

// The destination is held, so it can sound (decision 4): a released gain it feeds is kept, and a released gain feeding
// it is freed, since a node's outputs keep nothing alive.
fn string lifetime(ref OfflineAudioContext context) {
    AudioDestinationNode d = context.destination();
    Result<GainNode, AudioError> ra = GainNode.make(context: context);
    GainNode a = match (give ra) { case Ok(value: g): give g; case Err(error: e): { return "the first gain was refused"; } };
    Result<GainNode, AudioError> rb = GainNode.make(context: context);
    GainNode b = match (give rb) { case Ok(value: g): give g; case Err(error: e): { return "the second gain was refused"; } };
    string why = taken(r: a.connect(destination: d), what: "a's connect to the destination");
    if (!why.isEmpty()) { return why; }
    why = taken(r: d.connect(destination: b), what: "the destination's connect to b");
    if (!why.isEmpty()) { return why; }
    why = lands(context: context, sent: 4);
    if (!why.isEmpty()) { return why; }
    letGo(node: give a);
    letGo(node: give b);
    why = lands(context: context, sent: 2);
    if (!why.isEmpty()) { return why; }
    why = audioHolds(context: context, want: 1);
    if (!why.isEmpty()) { return "a feeding the destination and b fed by it, both released: ${why}"; }
    why = pollFrees(context: context, want: 1);
    if (!why.isEmpty()) { return why; }
    why = sounds(context: context, node: gainAt(n: 1), what: "b, fed by the destination");
    if (!why.isEmpty()) { return why; }
    return positionOf(context: context, node: gainAt(n: 0)) < 0 ? "" : "a, freed, was still in the order";
}

// ---- the order --------------------------------------------------------------------------------------------------------

// Every node after every node that feeds it: a chain fed from the highest slot to the lowest and on into the
// destination, a node feeding two of them, and a node that reaches nothing, which is in the order too.
fn string feedsFirst(ref OfflineAudioContext context) {
    AudioDestinationNode d = context.destination();
    Result<GainNode, AudioError> r0 = GainNode.make(context: context);
    GainNode g0 = match (give r0) { case Ok(value: g): give g; case Err(error: e): { return "gain 0 was refused"; } };
    Result<GainNode, AudioError> r1 = GainNode.make(context: context);
    GainNode g1 = match (give r1) { case Ok(value: g): give g; case Err(error: e): { return "gain 1 was refused"; } };
    Result<GainNode, AudioError> r2 = GainNode.make(context: context);
    GainNode g2 = match (give r2) { case Ok(value: g): give g; case Err(error: e): { return "gain 2 was refused"; } };
    Result<GainNode, AudioError> r3 = GainNode.make(context: context);
    GainNode g3 = match (give r3) { case Ok(value: g): give g; case Err(error: e): { return "gain 3 was refused"; } };
    Result<GainNode, AudioError> r4 = GainNode.make(context: context);
    GainNode g4 = match (give r4) { case Ok(value: g): give g; case Err(error: e): { return "gain 4 was refused"; } };
    Result<GainNode, AudioError> r5 = GainNode.make(context: context);
    GainNode g5 = match (give r5) { case Ok(value: g): give g; case Err(error: e): { return "gain 5 was refused"; } };
    string why = taken(r: g3.connect(destination: g2), what: "3 to 2");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g2.connect(destination: g1), what: "2 to 1");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g1.connect(destination: g0), what: "1 to 0");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g0.connect(destination: d), what: "0 to the destination");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g4.connect(destination: g1), what: "4 to 1");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g4.connect(destination: d), what: "4 to the destination");
    if (!why.isEmpty()) { return why; }
    why = lands(context: context, sent: 12);
    if (!why.isEmpty()) { return why; }
    int64 dest = destinationOf(nodes: 8);
    why = feedsBefore(context: context, from: gainAt(n: 3), to: gainAt(n: 2), what: "3 to 2");
    if (!why.isEmpty()) { return why; }
    why = feedsBefore(context: context, from: gainAt(n: 2), to: gainAt(n: 1), what: "2 to 1");
    if (!why.isEmpty()) { return why; }
    why = feedsBefore(context: context, from: gainAt(n: 1), to: gainAt(n: 0), what: "1 to 0");
    if (!why.isEmpty()) { return why; }
    why = feedsBefore(context: context, from: gainAt(n: 0), to: dest, what: "0 to the destination");
    if (!why.isEmpty()) { return why; }
    why = feedsBefore(context: context, from: gainAt(n: 4), to: gainAt(n: 1), what: "4 to 1");
    if (!why.isEmpty()) { return why; }
    why = feedsBefore(context: context, from: gainAt(n: 4), to: dest, what: "4 to the destination");
    if (!why.isEmpty()) { return why; }
    why = sounds(context: context, node: gainAt(n: 5), what: "gain 5, which reaches nothing");
    if (!why.isEmpty()) { return why; }
    return orderHolds(context: context, want: 7);
}

// A cycle with no delay is muted and left out: a node connected to itself, a cycle of two and one of three. A node
// feeding a cycle and a node a cycle feeds are not.
fn string cyclesMuted(ref OfflineAudioContext context) {
    AudioDestinationNode d = context.destination();
    Result<GainNode, AudioError> r0 = GainNode.make(context: context);
    GainNode g0 = match (give r0) { case Ok(value: g): give g; case Err(error: e): { return "gain 0 was refused"; } };
    Result<GainNode, AudioError> r1 = GainNode.make(context: context);
    GainNode g1 = match (give r1) { case Ok(value: g): give g; case Err(error: e): { return "gain 1 was refused"; } };
    Result<GainNode, AudioError> r2 = GainNode.make(context: context);
    GainNode g2 = match (give r2) { case Ok(value: g): give g; case Err(error: e): { return "gain 2 was refused"; } };
    Result<GainNode, AudioError> r3 = GainNode.make(context: context);
    GainNode g3 = match (give r3) { case Ok(value: g): give g; case Err(error: e): { return "gain 3 was refused"; } };
    Result<GainNode, AudioError> r4 = GainNode.make(context: context);
    GainNode g4 = match (give r4) { case Ok(value: g): give g; case Err(error: e): { return "gain 4 was refused"; } };
    Result<GainNode, AudioError> r5 = GainNode.make(context: context);
    GainNode g5 = match (give r5) { case Ok(value: g): give g; case Err(error: e): { return "gain 5 was refused"; } };
    Result<GainNode, AudioError> r6 = GainNode.make(context: context);
    GainNode g6 = match (give r6) { case Ok(value: g): give g; case Err(error: e): { return "gain 6 was refused"; } };
    Result<GainNode, AudioError> r7 = GainNode.make(context: context);
    GainNode g7 = match (give r7) { case Ok(value: g): give g; case Err(error: e): { return "gain 7 was refused"; } };
    string why = lands(context: context, sent: 8);
    if (!why.isEmpty()) { return "the makes: ${why}"; }
    why = taken(r: g0.connect(destination: g0), what: "0 to itself");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g1.connect(destination: g2), what: "1 to 2");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g2.connect(destination: g1), what: "2 to 1");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g3.connect(destination: g4), what: "3 to 4");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g4.connect(destination: g5), what: "4 to 5");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g5.connect(destination: g3), what: "5 to 3");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g6.connect(destination: g1), what: "6 to 1");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g2.connect(destination: g7), what: "2 to 7");
    if (!why.isEmpty()) { return why; }
    why = taken(r: g7.connect(destination: d), what: "7 to the destination");
    if (!why.isEmpty()) { return why; }
    why = lands(context: context, sent: 9);
    if (!why.isEmpty()) { return why; }
    why = mutedOut(context: context, node: gainAt(n: 0), what: "a gain connected to itself");
    if (!why.isEmpty()) { return why; }
    why = mutedOut(context: context, node: gainAt(n: 1), what: "gain 1, in a cycle of two");
    if (!why.isEmpty()) { return why; }
    why = mutedOut(context: context, node: gainAt(n: 2), what: "gain 2, in a cycle of two");
    if (!why.isEmpty()) { return why; }
    why = mutedOut(context: context, node: gainAt(n: 3), what: "gain 3, in a cycle of three");
    if (!why.isEmpty()) { return why; }
    why = mutedOut(context: context, node: gainAt(n: 4), what: "gain 4, in a cycle of three");
    if (!why.isEmpty()) { return why; }
    why = mutedOut(context: context, node: gainAt(n: 5), what: "gain 5, in a cycle of three");
    if (!why.isEmpty()) { return why; }
    why = sounds(context: context, node: gainAt(n: 6), what: "gain 6, feeding a cycle");
    if (!why.isEmpty()) { return why; }
    why = feedsBefore(context: context, from: gainAt(n: 7), to: destinationOf(nodes: 12), what: "7, fed by a cycle, to the destination");
    if (!why.isEmpty()) { return why; }
    return orderHolds(context: context, want: 3);
}

// Cycles the search reaches through the node that feeds them, not from their own lowest slot, are muted too: a gain at
// slot 0 feeds a cycle of two (slots 1 and 2) and a cycle of three (slots 3, 4 and 5), and the cycle of two feeds the
// destination. Only the feeder and the destination sound.
fn string deepCyclesMuted(ref OfflineAudioContext context) {
    AudioDestinationNode d = context.destination();
    Result<GainNode, AudioError> r0 = GainNode.make(context: context);
    GainNode f = match (give r0) { case Ok(value: g): give g; case Err(error: e): { return "the feeder was refused"; } };
    Result<GainNode, AudioError> r1 = GainNode.make(context: context);
    GainNode a = match (give r1) { case Ok(value: g): give g; case Err(error: e): { return "gain 1 was refused"; } };
    Result<GainNode, AudioError> r2 = GainNode.make(context: context);
    GainNode b = match (give r2) { case Ok(value: g): give g; case Err(error: e): { return "gain 2 was refused"; } };
    Result<GainNode, AudioError> r3 = GainNode.make(context: context);
    GainNode c = match (give r3) { case Ok(value: g): give g; case Err(error: e): { return "gain 3 was refused"; } };
    Result<GainNode, AudioError> r4 = GainNode.make(context: context);
    GainNode e4 = match (give r4) { case Ok(value: g): give g; case Err(error: e): { return "gain 4 was refused"; } };
    Result<GainNode, AudioError> r5 = GainNode.make(context: context);
    GainNode e5 = match (give r5) { case Ok(value: g): give g; case Err(error: e): { return "gain 5 was refused"; } };
    string why = lands(context: context, sent: 6);
    if (!why.isEmpty()) { return "the makes: ${why}"; }
    why = taken(r: f.connect(destination: a), what: "0 to 1");
    if (!why.isEmpty()) { return why; }
    why = taken(r: a.connect(destination: b), what: "1 to 2");
    if (!why.isEmpty()) { return why; }
    why = taken(r: b.connect(destination: a), what: "2 to 1");
    if (!why.isEmpty()) { return why; }
    why = taken(r: f.connect(destination: c), what: "0 to 3");
    if (!why.isEmpty()) { return why; }
    why = taken(r: c.connect(destination: e4), what: "3 to 4");
    if (!why.isEmpty()) { return why; }
    why = taken(r: e4.connect(destination: e5), what: "4 to 5");
    if (!why.isEmpty()) { return why; }
    why = taken(r: e5.connect(destination: c), what: "5 to 3");
    if (!why.isEmpty()) { return why; }
    why = taken(r: b.connect(destination: d), what: "2 to the destination");
    if (!why.isEmpty()) { return why; }
    why = lands(context: context, sent: 8);
    if (!why.isEmpty()) { return why; }
    int64 n = 1;
    while (n <= 5) {
        why = mutedOut(context: context, node: gainAt(n: n), what: "gain ${n}, in a cycle the feeder reaches");
        if (!why.isEmpty()) { return why; }
        n = n + 1;
    }
    why = sounds(context: context, node: gainAt(n: 0), what: "the feeder");
    if (!why.isEmpty()) { return why; }
    why = sounds(context: context, node: destinationOf(nodes: 8), what: "the destination");
    if (!why.isEmpty()) { return why; }
    return orderHolds(context: context, want: 2);
}

// The destination in a cycle is muted like any node: a gain feeding it and fed by it.
fn string destinationInCycle(ref OfflineAudioContext context) {
    AudioDestinationNode d = context.destination();
    Result<GainNode, AudioError> ra = GainNode.make(context: context);
    GainNode a = match (give ra) { case Ok(value: g): give g; case Err(error: e): { return "the gain was refused"; } };
    string why = taken(r: a.connect(destination: d), what: "the gain's connect to the destination");
    if (!why.isEmpty()) { return why; }
    why = taken(r: d.connect(destination: a), what: "the destination's connect to the gain");
    if (!why.isEmpty()) { return why; }
    why = lands(context: context, sent: 3);
    if (!why.isEmpty()) { return why; }
    why = mutedOut(context: context, node: destinationOf(nodes: 4), what: "the destination, in a cycle with a gain");
    if (!why.isEmpty()) { return why; }
    why = mutedOut(context: context, node: gainAt(n: 0), what: "the gain, in a cycle with the destination");
    if (!why.isEmpty()) { return why; }
    return orderHolds(context: context, want: 0);
}

// The order follows the graph. It holds the destination from the first quantum; a make adds a node to it; a connect
// that closes a cycle mutes it; a free takes a node out; and a slot taken again holds a node that is not muted.
fn string reorders(ref OfflineAudioContext context) {
    AudioDestinationNode d = context.destination();
    string why = quantumApplies(context: context, want: 0);
    if (!why.isEmpty()) { return why; }
    why = orderHolds(context: context, want: 1);
    if (!why.isEmpty()) { return "the first quantum: ${why}"; }
    Result<GainNode, AudioError> ra = GainNode.make(context: context);
    GainNode a = match (give ra) { case Ok(value: g): give g; case Err(error: e): { return "the first gain was refused"; } };
    why = lands(context: context, sent: 1);
    if (!why.isEmpty()) { return why; }
    why = sounds(context: context, node: gainAt(n: 0), what: "a gain once made");
    if (!why.isEmpty()) { return why; }
    why = orderHolds(context: context, want: 2);
    if (!why.isEmpty()) { return "after a make: ${why}"; }
    why = taken(r: a.connect(destination: a), what: "the gain's connect to itself");
    if (!why.isEmpty()) { return why; }
    why = lands(context: context, sent: 1);
    if (!why.isEmpty()) { return why; }
    why = mutedOut(context: context, node: gainAt(n: 0), what: "the gain once connected to itself");
    if (!why.isEmpty()) { return why; }
    letGo(node: give a);
    why = lands(context: context, sent: 1);
    if (!why.isEmpty()) { return why; }
    why = pollFrees(context: context, want: 1);
    if (!why.isEmpty()) { return "the gain connected only to itself, released: ${why}"; }
    // A freed slot is taken again last (decision 34): b takes slot 1, and c the muted gain's slot 0, at generation 2.
    Result<GainNode, AudioError> rb = GainNode.make(context: context);
    GainNode b = match (give rb) { case Ok(value: g): give g; case Err(error: e): { return "the second gain was refused"; } };
    Result<GainNode, AudioError> rc = GainNode.make(context: context);
    GainNode c = match (give rc) { case Ok(value: g): give g; case Err(error: e): { return "the third gain was refused"; } };
    why = taken(r: b.connect(destination: d), what: "the second gain's connect to the destination");
    if (!why.isEmpty()) { return why; }
    why = lands(context: context, sent: 3);
    if (!why.isEmpty()) { return why; }
    int64 again = idAt(slot: 0, generation: 2);
    why = sounds(context: context, node: again, what: "the third gain, in the muted gain's slot taken again");
    if (!why.isEmpty()) { return why; }
    why = feedsBefore(context: context, from: gainAt(n: 1), to: destinationOf(nodes: 2), what: "the second gain to the destination");
    if (!why.isEmpty()) { return why; }
    why = orderHolds(context: context, want: 3);
    if (!why.isEmpty()) { return "with two gains and the destination: ${why}"; }
    letGo(node: give c);
    why = lands(context: context, sent: 1);
    if (!why.isEmpty()) { return why; }
    why = positionOf(context: context, node: again) < 0 ? "" : "the third gain, freed, was still in the order";
    if (!why.isEmpty()) { return why; }
    return orderHolds(context: context, want: 2);
}

fn void destinationTests(ref Tally t) {
    t.verdict(name: "destination: its channel count is the context's, and so is the most it can be set to", why: channels());
    withLinks(t: t, name: "destination: a gain connects to it and it to a gain, the same connection sent once", nodes: 4,
              backlog: 16, connections: 4, body: connectsBothWays);
    withLinks(t: t, name: "destination: another context's node is refused as InvalidAccess both ways, and nothing is sent",
              nodes: 4, backlog: 16, connections: 4, body: otherContext);
    withLinks(t: t, name: "destination: it takes no row, and its connections land on the audio side", nodes: 1,
              backlog: 16, connections: 2, body: noRow);
    withLinks(t: t, name: "destination: nothing releases it, and the audio side keeps it in the order", nodes: 4,
              backlog: 16, connections: 4, body: neverReleased);
    withLinks(t: t, name: "destination: it can sound, so a released gain it feeds is kept, and one feeding it is freed",
              nodes: 4, backlog: 16, connections: 4, body: lifetime);
    withLinks(t: t, name: "destination: the order puts every node after the nodes that feed it, reaching it or not",
              nodes: 8, backlog: 32, connections: 8, body: feedsFirst);
    withLinks(t: t, name: "destination: a cycle with no delay is muted and left out of the order, and what it feeds is not",
              nodes: 12, backlog: 32, connections: 16, body: cyclesMuted);
    withLinks(t: t, name: "destination: cycles the search reaches through their feeder are muted too", nodes: 8,
              backlog: 32, connections: 16, body: deepCyclesMuted);
    withLinks(t: t, name: "destination: the destination in a cycle is muted like any node", nodes: 4, backlog: 16,
              connections: 4, body: destinationInCycle);
    withLinks(t: t, name: "destination: a make, a connect and a free each re-order the graph", nodes: 2, backlog: 16,
              connections: 4, body: reorders);
}
