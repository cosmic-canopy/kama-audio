// @kama/audio's tests, one program (kama's AGENTS.package.md: `tests/` is one program). tools/test.sh builds it debug
// and release and runs it natively, and builds it for wasm and runs it under node. A failing case prints its name, and
// the exit status is 1 when any case failed. Nothing here makes a sound: every render is offline.

import { core::println, Tally, ringTests, backlogTests, slotsTests, slotArrayTests, nodesTests, commandsTests,
         audioSideTests, connectTests, renderTests };

fn uint8 main() {
    Tally t = Tally.make();
    ringTests(t: t);
    backlogTests(t: t);
    slotsTests(t: t);
    slotArrayTests(t: t);
    nodesTests(t: t);
    commandsTests(t: t);
    audioSideTests(t: t);
    connectTests(t: t);
    renderTests(t: t);
    int32 runs = t.count();
    int32 failed = t.failed();
    println(s: "audio tests: ${runs} cases, ${failed} failed");
    if (failed > 0) { return 1; }
    return 0;
}
