// nodes: a node as a counted resource over its context's slot table, and the program's memory as callbacks (AUD-2 and
// AUD-4's first part; AGENTS.audio.md decisions 4, 6, 34, 35 and 36).
// - A context draws its slot table and its state from the program's memory, once, and both go back with the last hold,
//   the context's or a node's (decisions 4, 6, 36).
// - Making a node takes a row; `copy` counts it up and a `give` moves it; the last drop marks the row, whose release
//   comes out in the order the drops were made, and the row stays held until the audio side frees it (decisions 34, 35).
// - Every limit answers at the make, never with a trap: Web Audio's ranges as `NotSupported`, memory with no room as
//   `OutOfMemory`, a full table as `TooManyNodes`.
// These tests are a program with an allocator of its own: three free functions over a few counters (decision 36).

import { Tally, audio::AudioMemory, audio::OfflineAudioContext, audio::OfflineAudioContextOptions, audio::AudioError,
         audio::GainNode, audio::rt::slotOf, audio::rt::generationOf, std::collections::Arena,
         std::collections::DynamicArray };

export { nodesTests, rowsHeldIn, releaseDueIn };

// The package's seam into a context (`friend` grants in `src/context.kama`): its rows held, and its next release due.
fn isize rowsHeldIn(ref OfflineAudioContext context) { return context.rowsHeld(); }

fn Optional<int64> releaseDueIn(ref OfflineAudioContext context) { return context.releaseDue(); }

// ---- the tests' own allocator: four counters behind the user pointer ------------------------------------------------
// 0: blocks out now, 1: bytes out now, 2: allocations made, 3: the budget in bytes, or -1 for none.

unsafe fn Optional<UnsafePtr> countedAllocate(UnsafePtr user, usize bytes, usize align) {
    UnsafePtr<int64> c = cast<UnsafePtr<int64>>(user);
    if (c[3] >= 0 && c[1] + cast<int64>(bytes) > c[3]) { return Optional::None; }
    c[0] = c[0] + 1;
    c[1] = c[1] + cast<int64>(bytes);
    c[2] = c[2] + 1;
    return GlobalAllocator.make().allocate(bytes: bytes, align: align);
}

// The package never resizes a block, so the tests' allocator has no room for one.
unsafe fn Optional<UnsafePtr> countedReallocate(UnsafePtr user, UnsafePtr pointer, usize bytes, usize newBytes, usize align) {
    return Optional::None;
}

unsafe fn void countedDeallocate(UnsafePtr user, UnsafePtr pointer, usize bytes, usize align) {
    UnsafePtr<int64> c = cast<UnsafePtr<int64>>(user);
    c[0] = c[0] - 1;
    c[1] = c[1] - cast<int64>(bytes);
    GlobalAllocator.make().deallocate(pointer: pointer, bytes: bytes, align: align);
}

unsafe fn AudioMemory countedIn(UnsafePtr<int64> cells) {
    return AudioMemory.make(user: cast<UnsafePtr>(cells), allocate: countedAllocate, reallocate: countedReallocate,
                            deallocate: countedDeallocate);
}

// ---- helpers ----------------------------------------------------------------------------------------------------------

fn OfflineAudioContextOptions optionsIn(AudioMemory memory, isize nodes) {
    OfflineAudioContextOptions o = OfflineAudioContextOptions.make(length: 128, sampleRate: 48000);
    o.memory = memory;
    o.nodeCapacity = nodes;
    return o;
}

fn string named(AudioError e) {
    return match (e) {
        case NotSupported: "NotSupported";
        case OutOfMemory: "OutOfMemory";
        case TooManyNodes: "TooManyNodes";
    };
}

// The end of a node's handle: it is moved in, and dropped when this returns.
fn void letGo(GainNode node) { }

// Says what is wrong with the next release due, or "" when it is the row at `slot` and generation 1.
fn string expectRelease(ref OfflineAudioContext context, int64 slot) {
    Optional<int64> got = releaseDueIn(context: context);
    return match (got) {
        case Some(value: id): {
            int64 s = slotOf(id: id);
            int64 g = generationOf(id: id);
            return s == slot && g == 1 ? "" : "slot ${s} at generation ${g}'s release came out where slot ${slot}'s was due";
        }
        case None: "no release was due where slot ${slot}'s was";
    };
}

fn string expectNoRelease(ref OfflineAudioContext context) {
    Optional<int64> got = releaseDueIn(context: context);
    return match (got) {
        case Some(value: id): {
            int64 s = slotOf(id: id);
            return "slot ${s}'s release came out where none was due";
        }
        case None: "";
    };
}

fnptr string ContextCase(ref OfflineAudioContext context);

// Runs `body` on a fresh context of `nodes` rows on the global heap.
fn void withContext(ref Tally t, const ref string name, isize nodes, ContextCase body) {
    Result<OfflineAudioContext, AudioError> made = OfflineAudioContext.make(options: optionsIn(memory: AudioMemory.global(), nodes: nodes));
    match (give made) {
        case Ok(value: c0): {
            OfflineAudioContext context = give c0;
            string why = body(context: context);
            t.verdict(name: name, why: why);
        }
        case Err(error: e): {
            string m = e.message();
            t.verdict(name: name, why: "the context was not made: ${m}");
        }
    };
}

// ---- the program's memory ---------------------------------------------------------------------------------------------

// The ready-made callbacks reach the global heap and an std Arena: the arena runs out where the heap would not, and
// has room again after its reset.
unsafe fn string readyMade() {
    AudioMemory heap = AudioMemory.global();
    Optional<UnsafePtr> p = heap.allocate(bytes: 16, align: 8);
    UnsafePtr block = null;
    match (p) { case Some(value: x): { block = x; } case None: { } };
    if (block == null) { return "the global heap's callbacks had no room for 16 bytes"; }
    UnsafePtr<uint8> written = cast<UnsafePtr<uint8>>(block);
    written[0] = 7;
    Optional<UnsafePtr> grown = heap.reallocate(pointer: block, bytes: 16, newBytes: 4096, align: 8);
    UnsafePtr bigger = null;
    match (grown) { case Some(value: x): { bigger = x; } case None: { } };
    if (bigger == null) { return "the global heap's callbacks could not grow a block"; }
    UnsafePtr<uint8> read = cast<UnsafePtr<uint8>>(bigger);
    uint8 kept = read[0];
    heap.deallocate(pointer: bigger, bytes: 4096, align: 8);
    if (kept != 7) { return "a block grown through the global heap's callbacks lost its bytes"; }

    Arena arena = Arena.make(capacity: 64);
    AudioMemory inArena = AudioMemory.inArena(arena: arena);
    Optional<UnsafePtr> first = inArena.allocate(bytes: 48, align: 8);
    Optional<UnsafePtr> second = inArena.allocate(bytes: 48, align: 8);
    bool firstFit = match (first) { case Some(value: x): true; case None: false; };
    bool secondFit = match (second) { case Some(value: x): true; case None: false; };
    if (!firstFit) { return "an arena of 64 bytes had no room for 48"; }
    if (secondFit) { return "an arena of 64 bytes gave 48 bytes twice, so the callbacks did not draw from it"; }
    arena.reset();
    Optional<UnsafePtr> again = inArena.allocate(bytes: 48, align: 8);
    bool againFit = match (again) { case Some(value: x): true; case None: false; };
    return againFit ? "" : "the arena had no room after its reset";
}

// A context takes its slot table and its state from the program's memory, two allocations, and making nodes takes
// none. Its state outlives the context's handle while a node holds it, and everything goes back at the last drop.
unsafe fn string lastHold() {
    InlineArray<int64>#(4) cells = [0; (4)];
    cells[3] = -1;
    UnsafePtr<int64> c = addr(of: cells[0]);
    Optional<GainNode> kept = Optional::None;
    {
        Result<OfflineAudioContext, AudioError> made = OfflineAudioContext.make(options: optionsIn(memory: countedIn(cells: c), nodes: 4));
        match (give made) {
            case Ok(value: context): {
                int64 made2 = c[2];
                if (made2 != 2) { return "the context took ${made2} allocations where 2, its table and its state, were due"; }
                Result<GainNode, AudioError> g = GainNode.make(context: context);
                match (give g) {
                    case Ok(value: node): { kept = Optional::Some(value: give node); }
                    case Err(error: e): { string m = named(e: e); return "the node was refused: ${m}"; }
                };
                int64 after = c[2];
                if (after != 2) { return "making a node allocated: ${after} allocations where the context's 2 were due"; }
            }
            case Err(error: e): { string m = named(e: e); return "the context was refused: ${m}"; }
        };
    }
    int64 held = c[0];
    if (held != 2) { return "the context's handle left ${held} of 2 blocks out where the node still held its state"; }
    match (give kept) {
        case Some(value: node): {
            GainNode other = copy node;
            letGo(node: give other);
            int64 still = c[0];
            if (still != 2) { return "a copy's drop gave back blocks while the node still held its state"; }
            letGo(node: give node);
        }
        case None: { return "the node was lost"; }
    };
    int64 blocks = c[0];
    int64 bytes = c[1];
    return blocks == 0 && bytes == 0 ? "" : "${blocks} blocks and ${bytes} bytes were still out after the last hold";
}

// ---- the make's answers -----------------------------------------------------------------------------------------------

// Says what is wrong with making a context from `o`: "" when it answers `want`, or is made when `want` is empty, and
// in either case leaves nothing out.
unsafe fn string answers(OfflineAudioContextOptions o, UnsafePtr<int64> c, const ref string want, const ref string what) {
    {
        Result<OfflineAudioContext, AudioError> made = OfflineAudioContext.make(options: o);
        match (give made) {
            case Ok(value: context): { if (!want.isEmpty()) { return "${what} was made where ${want} was due"; } }
            case Err(error: e): {
                string got = named(e: e);
                if (got != want) {
                    return want.isEmpty() ? "${what} was refused as ${got}" : "${what} answered ${got} where ${want} was due";
                }
            }
        };
    }
    int64 blocks = c[0];
    return blocks == 0 ? "" : "${what} left ${blocks} blocks out";
}

// Web Audio's ranges: 1 to 32 channels, a length of at least one frame, a sample rate from 3,000 to 768,000 Hz; and
// at least one node. Each refusal is NotSupported and allocates nothing; each bound itself is made.
unsafe fn string ranges() {
    InlineArray<int64>#(4) cells = [0; (4)];
    cells[3] = -1;
    UnsafePtr<int64> c = addr(of: cells[0]);
    AudioMemory m = countedIn(cells: c);
    OfflineAudioContextOptions o = optionsIn(memory: m, nodes: 4);
    o.numberOfChannels = 0;
    string why = answers(o: o, c: c, want: "NotSupported", what: "0 channels");
    if (!why.isEmpty()) { return why; }
    o.numberOfChannels = 33;
    why = answers(o: o, c: c, want: "NotSupported", what: "33 channels");
    if (!why.isEmpty()) { return why; }
    o.numberOfChannels = 32;
    why = answers(o: o, c: c, want: "", what: "32 channels");
    if (!why.isEmpty()) { return why; }
    o = optionsIn(memory: m, nodes: 4);
    o.length = 0;
    why = answers(o: o, c: c, want: "NotSupported", what: "a length of 0");
    if (!why.isEmpty()) { return why; }
    o.length = 1;
    why = answers(o: o, c: c, want: "", what: "a length of 1");
    if (!why.isEmpty()) { return why; }
    o = optionsIn(memory: m, nodes: 4);
    o.sampleRate = 2999;
    why = answers(o: o, c: c, want: "NotSupported", what: "2,999 Hz");
    if (!why.isEmpty()) { return why; }
    o.sampleRate = 3000;
    why = answers(o: o, c: c, want: "", what: "3,000 Hz");
    if (!why.isEmpty()) { return why; }
    o.sampleRate = 768000;
    why = answers(o: o, c: c, want: "", what: "768,000 Hz");
    if (!why.isEmpty()) { return why; }
    o.sampleRate = 768001;
    why = answers(o: o, c: c, want: "NotSupported", what: "768,001 Hz");
    if (!why.isEmpty()) { return why; }
    o = optionsIn(memory: m, nodes: 0);
    why = answers(o: o, c: c, want: "NotSupported", what: "no nodes");
    if (!why.isEmpty()) { return why; }
    o = optionsIn(memory: m, nodes: 1);
    return answers(o: o, c: c, want: "", what: "one node");
}

// Memory with no room for the context is OutOfMemory at every budget short of it, and leaves nothing out: not even the
// slot table, when the table fits and the state does not. The context is made once both fit.
unsafe fn string noRoom() {
    InlineArray<int64>#(4) cells = [0; (4)];
    UnsafePtr<int64> c = addr(of: cells[0]);
    bool tableThenRefused = false;
    int64 budget = 0;
    while (budget <= 4096) {
        cells[0] = 0;
        cells[1] = 0;
        cells[2] = 0;
        cells[3] = budget;
        bool made = false;
        {
            Result<OfflineAudioContext, AudioError> got = OfflineAudioContext.make(options: optionsIn(memory: countedIn(cells: c), nodes: 4));
            match (give got) {
                case Ok(value: context): { made = true; }
                case Err(error: e): {
                    string n = named(e: e);
                    if (n != "OutOfMemory") { return "a budget of ${budget} bytes answered ${n} where OutOfMemory was due"; }
                    if (c[2] > 0) { tableThenRefused = true; }
                }
            };
        }
        int64 blocks = c[0];
        if (blocks != 0) { return "a budget of ${budget} bytes left ${blocks} blocks out"; }
        if (made) {
            return tableThenRefused ? "" : "no budget had room for the table and not the state, so that refusal was never seen";
        }
        budget = budget + 8;
    }
    return "no budget up to 4,096 bytes made a context of 4 nodes";
}

// ---- a node's row -----------------------------------------------------------------------------------------------------

// A make takes a row, the first at slot 0; the row is held after the last drop, and its release is due once.
fn string takesRow(ref OfflineAudioContext context) {
    isize before = rowsHeldIn(context: context);
    if (before != 0) { return "a fresh context held ${before} rows"; }
    Result<GainNode, AudioError> g = GainNode.make(context: context);
    match (give g) {
        case Ok(value: node): {
            isize held = rowsHeldIn(context: context);
            if (held != 1) { return "a make left ${held} rows held where 1 was due"; }
            string none = expectNoRelease(context: context);
            if (!none.isEmpty()) { return none; }
            letGo(node: give node);
        }
        case Err(error: e): { string m = named(e: e); return "the node was refused: ${m}"; }
    };
    isize after = rowsHeldIn(context: context);
    if (after != 1) { return "the last drop left ${after} rows held where 1 was due, until the audio side frees it"; }
    string due = expectRelease(context: context, slot: 0);
    if (!due.isEmpty()) { return due; }
    return expectNoRelease(context: context);
}

// `copy` counts the row up, so dropping the original releases nothing; a `give` moves the handle without counting; the
// last drop releases the row once.
fn string copies(ref OfflineAudioContext context) {
    Result<GainNode, AudioError> g = GainNode.make(context: context);
    match (give g) {
        case Ok(value: node): {
            GainNode other = copy node;
            letGo(node: give node);
            string first = expectNoRelease(context: context);
            if (!first.isEmpty()) { return "after the original's drop, with a copy held: ${first}"; }
            GainNode moved = give other;
            string second = expectNoRelease(context: context);
            if (!second.isEmpty()) { return "after a give: ${second}"; }
            letGo(node: give moved);
        }
        case Err(error: e): { string m = named(e: e); return "the node was refused: ${m}"; }
    };
    string due = expectRelease(context: context, slot: 0);
    if (!due.isEmpty()) { return "after the last drop: ${due}"; }
    return expectNoRelease(context: context);
}

// Releases come out in the order the last drops were made, not the order the nodes were made.
fn string releaseOrder(ref OfflineAudioContext context) {
    Result<GainNode, AudioError> a = GainNode.make(context: context);
    Result<GainNode, AudioError> b = GainNode.make(context: context);
    Result<GainNode, AudioError> c = GainNode.make(context: context);
    match (give a) {
        case Ok(value: na): {
            match (give b) {
                case Ok(value: nb): {
                    match (give c) {
                        case Ok(value: nc): {
                            letGo(node: give nb);
                            letGo(node: give na);
                            letGo(node: give nc);
                        }
                        case Err(error: e): { return "the third node was refused"; }
                    };
                }
                case Err(error: e): { return "the second node was refused"; }
            };
        }
        case Err(error: e): { return "the first node was refused"; }
    };
    string r1 = expectRelease(context: context, slot: 1);
    if (!r1.isEmpty()) { return "first: ${r1}"; }
    string r2 = expectRelease(context: context, slot: 0);
    if (!r2.isEmpty()) { return "second: ${r2}"; }
    string r3 = expectRelease(context: context, slot: 2);
    if (!r3.isEmpty()) { return "third: ${r3}"; }
    return expectNoRelease(context: context);
}

// With every row held, a make answers TooManyNodes and changes nothing. A dropped node's row stays held until the audio
// side frees it, so the make is still refused after the drop.
fn string full(ref OfflineAudioContext context) {
    Result<GainNode, AudioError> a = GainNode.make(context: context);
    Result<GainNode, AudioError> b = GainNode.make(context: context);
    match (give a) {
        case Ok(value: na): {
            Result<GainNode, AudioError> third = GainNode.make(context: context);
            match (give third) {
                case Ok(value: n): { return "a context of 2 rows made a third node"; }
                case Err(error: e): {
                    string got = named(e: e);
                    if (got != "TooManyNodes") { return "the third node answered ${got} where TooManyNodes was due"; }
                }
            };
            isize held = rowsHeldIn(context: context);
            if (held != 2) { return "the refused make left ${held} rows held where 2 were due"; }
            string none = expectNoRelease(context: context);
            if (!none.isEmpty()) { return "the refused make: ${none}"; }
            letGo(node: give na);
        }
        case Err(error: e): { return "the first node was refused"; }
    };
    Result<GainNode, AudioError> again = GainNode.make(context: context);
    match (give again) {
        case Ok(value: n): { return "a dropped node's row was handed out before the audio side freed it"; }
        case Err(error: e): { }
    };
    match (give b) { case Ok(value: nb): { } case Err(error: e): { return "the second node was refused"; } };
    return expectRelease(context: context, slot: 0);
}

// A thousand copies and their drops balance: the row is released once, after the last.
fn string thousand(ref OfflineAudioContext context) {
    Result<GainNode, AudioError> g = GainNode.make(context: context);
    match (give g) {
        case Ok(value: node): {
            {
                DynamicArray<GainNode> many = DynamicArray.empty();
                int32 i = 0;
                while (i < 1000) {
                    many.add(item: copy node);
                    i = i + 1;
                }
                letGo(node: give node);
                string none = expectNoRelease(context: context);
                if (!none.isEmpty()) { return "with a thousand copies held: ${none}"; }
            }
        }
        case Err(error: e): { string m = named(e: e); return "the node was refused: ${m}"; }
    };
    string due = expectRelease(context: context, slot: 0);
    if (!due.isEmpty()) { return "after the thousandth copy's drop: ${due}"; }
    return expectNoRelease(context: context);
}

fn void nodesTests(ref Tally t) {
    t.verdict(name: "nodes: the ready-made callbacks draw from the global heap and from an Arena", why: readyMade());
    t.verdict(name: "nodes: a context takes its table and state from the program's memory once, and the last hold gives them back",
              why: lastHold());
    t.verdict(name: "nodes: an option outside Web Audio's ranges is NotSupported, and allocates nothing", why: ranges());
    t.verdict(name: "nodes: memory with no room is OutOfMemory at every budget short of the context, leaving nothing out",
              why: noRoom());
    withContext(t: t, name: "nodes: a make takes a row, held after the last drop until the audio side frees it", nodes: 4,
                body: takesRow);
    withContext(t: t, name: "nodes: a copy counts the row up, a give moves it, and the last drop releases it once", nodes: 4,
                body: copies);
    withContext(t: t, name: "nodes: releases come out in the order the last drops were made", nodes: 4, body: releaseOrder);
    withContext(t: t, name: "nodes: with every row held a make answers TooManyNodes and changes nothing", nodes: 2,
                body: full);
    withContext(t: t, name: "nodes: a thousand copies and their drops balance", nodes: 4, body: thousand);
}
