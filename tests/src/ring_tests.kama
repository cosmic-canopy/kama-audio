// command-ring: audio::rt::Ring, the single-producer, single-consumer ring under the command protocol (AUD-1;
// AGENTS.audio.md decisions 5 to 8, 33). The program's side pushes, the audio side pops each quantum.
// - Its capacity is declared, and its storage comes from the allocator the program hands it (decision 6).
// - A full ring refuses a push and keeps what it holds: the backlog in front of it is the program's side's (decision 8).
// - What is staged is published with one store, so the consumer sees a flush whole or not at all (decision 33).
// - Its pop allocates nothing and never waits (decision 5): the drain is `@noheap`, called from another thread
//   (crossing.kama).

import { Tally, Probe, Crossing, Counting, crossing, COUNT, audio::rt::Ring, audio::rt::CapacityError };

export { ringTests, expectSeq, expectEmpty };

fnptr string RingCase(ref Ring<Probe> r);

fn void withRing(ref Tally t, const ref string name, isize capacity, RingCase body) {
    Result<Ring<Probe>, CapacityError> made = Ring::<Probe>.withCapacity(capacity: capacity);
    match (give made) {
        case Ok(value: r): {
            Ring<Probe> ring = give r;
            string why = body(r: ring);
            t.verdict(name: name, why: why);
        }
        case Err(error: e): {
            string m = e.message();
            t.verdict(name: name, why: "the ring was not made: ${m}");
        }
    };
}

// Pops one and says what is wrong with it, or "" when it is `seq` and whole.
fn string expectSeq(ref Ring<Probe> r, int64 seq) {
    Optional<Probe> got = r.pop();
    return match (got) {
        case Some(value: p): p.seq == seq && p.whole() ? "" : "popped seq ${p.seq} where ${seq} was due";
        case None: "the ring was empty where seq ${seq} was due";
    };
}

fn string expectEmpty(ref Ring<Probe> r) {
    Optional<Probe> got = r.pop();
    return match (got) { case Some(value: p): "popped seq ${p.seq} from a ring that should be empty"; case None: ""; };
}

fn string freshIsEmpty(ref Ring<Probe> r) {
    isize cap = r.capacity();
    if (cap != 4) { return "its capacity is ${cap}, not the 4 declared"; }
    return expectEmpty(r: r);
}

fn string inOrder(ref Ring<Probe> r) {
    int64 i = 0;
    while (i < 8) {
        if (!r.push(item: Probe.make(seq: i))) { return "push ${i} of 8 was refused by a ring of 8"; }
        i = i + 1;
    }
    i = 0;
    while (i < 8) {
        string why = expectSeq(r: r, seq: i);
        if (!why.isEmpty()) { return why; }
        i = i + 1;
    }
    return expectEmpty(r: r);
}

fn string fullRefuses(ref Ring<Probe> r) {
    int64 i = 0;
    while (i < 4) {
        if (!r.push(item: Probe.make(seq: i))) { return "push ${i} of 4 was refused by a ring of 4"; }
        i = i + 1;
    }
    if (r.push(item: Probe.make(seq: 99))) { return "a full ring took a fifth push"; }
    i = 0;
    while (i < 4) {
        string why = expectSeq(r: r, seq: i);
        if (!why.isEmpty()) { return why; }
        i = i + 1;
    }
    string after = expectEmpty(r: r);
    if (!after.isEmpty()) { return after; }
    if (!r.push(item: Probe.make(seq: 4))) { return "a ring emptied after it was full refused a push"; }
    return expectSeq(r: r, seq: 4);
}

// A capacity of 3 is not a power of two, and 3,000 commands take the counters a thousand times round it.
fn string wraps(ref Ring<Probe> r) {
    int64 next = 0;
    int64 due = 0;
    int32 round = 0;
    while (round < 1000) {
        if (!r.push(item: Probe.make(seq: next))) { return "push ${next} refused with one held"; }
        next = next + 1;
        if (!r.push(item: Probe.make(seq: next))) { return "push ${next} refused with two held"; }
        next = next + 1;
        if (!r.push(item: Probe.make(seq: next))) { return "push ${next} refused with three free"; }
        next = next + 1;
        if (r.push(item: Probe.make(seq: -1))) { return "a full ring took a push in round ${round}"; }
        int32 k = 0;
        while (k < 3) {
            string why = expectSeq(r: r, seq: due);
            if (!why.isEmpty()) { return why; }
            due = due + 1;
            k = k + 1;
        }
        round = round + 1;
    }
    return expectEmpty(r: r);
}

fn void badCapacity(ref Tally t) {
    Result<Ring<Probe>, CapacityError> zero = Ring::<Probe>.withCapacity(capacity: 0);
    Result<Ring<Probe>, CapacityError> negative = Ring::<Probe>.withCapacity(capacity: -1);
    bool zeroRefused = match (zero) { case Ok(value: r): false; case Err(error: e): e == CapacityError::BadCapacity; };
    bool negativeRefused = match (negative) { case Ok(value: r): false; case Err(error: e): e == CapacityError::BadCapacity; };
    string why = zeroRefused && negativeRefused ? "" : "zero refused: ${zeroRefused}, -1 refused: ${negativeRefused}";
    t.verdict(name: "command-ring: a capacity below one is refused as BadCapacity", why: why);
}

// ---- the injected allocator ---------------------------------------------------------------------------------------

// Makes a ring of 16 through `a`, uses it, and drops it when it returns. "" when it was made and used.
unsafe fn string useRingFrom(Counting a) {
    Result<Ring<Probe, Counting>, CapacityError> made = Ring::<Probe, Counting>.withCapacityAndAllocator(allocator: a, capacity: 16);
    return match (give made) {
        case Ok(value: r): {
            Ring<Probe, Counting> ring = give r;
            bool pushed = ring.push(item: Probe.make(seq: 5));
            Optional<Probe> got = ring.pop();
            bool popped = match (got) { case Some(value: p): p.seq == 5; case None: false; };
            return pushed && popped ? "" : "a push and a pop through it failed";
        }
        case Err(error: e): {
            string m = e.message();
            return "the ring was not made: ${m}";
        }
    };
}

unsafe fn void fromTheAllocator(ref Tally t) {
    InlineArray<int64>#(5) cells = [0; (5)];
    Counting a = Counting.make(cells: addr(of: cells[0]), room: true);
    string used = useRingFrom(a: a);
    int64 want = 16 * cast<int64>(sizeof(Probe));
    string why = give used;
    if (why.isEmpty() && (cells[0] != 1 || cells[1] != want)) {
        int64 n = cells[0];
        int64 b = cells[1];
        why = "${n} allocations of ${b} bytes, not one of ${want}";
    }
    if (why.isEmpty() && (cells[2] != 1 || cells[3] != want)) {
        int64 n = cells[2];
        int64 b = cells[3];
        why = "${n} frees of ${b} bytes after the drop, not one of ${want}";
    }
    if (why.isEmpty() && cells[4] != 0) { why = "it reallocated, and a ring never grows"; }
    t.verdict(name: "command-ring: its storage comes from the injected allocator, once, and goes back to it at the drop", why: why);
}

unsafe fn void noRoom(ref Tally t) {
    InlineArray<int64>#(5) cells = [0; (5)];
    Counting a = Counting.make(cells: addr(of: cells[0]), room: false);
    Result<Ring<Probe, Counting>, CapacityError> made = Ring::<Probe, Counting>.withCapacityAndAllocator(allocator: a, capacity: 16);
    bool refused = match (made) { case Ok(value: r): false; case Err(error: e): e == CapacityError::OutOfMemory; };
    string why = refused ? "" : "a ring was made with no memory to hold it";
    t.verdict(name: "command-ring: an allocator with no room refuses the ring as OutOfMemory, and none is made", why: why);
}

// ---- staged, then published -------------------------------------------------------------------------------------

fn string stagedUnseen(ref Ring<Probe> r) {
    int64 i = 0;
    while (i < 3) {
        if (!r.stage(item: Probe.make(seq: i))) { return "stage ${i} of 3 was refused by an empty ring of 8"; }
        i = i + 1;
    }
    string hidden = expectEmpty(r: r);
    if (!hidden.isEmpty()) { return "before publish(): ${hidden}"; }
    r.publish();
    i = 0;
    while (i < 3) {
        string why = expectSeq(r: r, seq: i);
        if (!why.isEmpty()) { return why; }
        i = i + 1;
    }
    string after = expectEmpty(r: r);
    if (!after.isEmpty()) { return after; }
    // A second batch: what was staged starts again from none.
    if (!r.stage(item: Probe.make(seq: 3)) || !r.stage(item: Probe.make(seq: 4))) { return "a second batch was refused"; }
    string hiddenAgain = expectEmpty(r: r);
    if (!hiddenAgain.isEmpty()) { return "before the second publish(): ${hiddenAgain}"; }
    r.publish();
    string third = expectSeq(r: r, seq: 3);
    if (!third.isEmpty()) { return third; }
    string fourth = expectSeq(r: r, seq: 4);
    if (!fourth.isEmpty()) { return fourth; }
    return expectEmpty(r: r);
}

// A ring of 4 holding one published and three staged is full, and frees room only as the consumer pops.
fn string stagedCounts(ref Ring<Probe> r) {
    if (!r.push(item: Probe.make(seq: 0))) { return "a push onto an empty ring of 4 was refused"; }
    int64 i = 1;
    while (i < 4) {
        if (!r.stage(item: Probe.make(seq: i))) { return "stage ${i} was refused with ${i} held of 4"; }
        i = i + 1;
    }
    if (r.stage(item: Probe.make(seq: 99))) { return "a ring holding one and staging three took a fifth"; }
    if (r.push(item: Probe.make(seq: 98))) { return "a push onto a ring full of staged items was taken"; }
    string first = expectSeq(r: r, seq: 0);
    if (!first.isEmpty()) { return first; }
    string hidden = expectEmpty(r: r);
    if (!hidden.isEmpty()) { return "a refused push published what was staged: ${hidden}"; }
    if (!r.stage(item: Probe.make(seq: 4))) { return "the room the pop freed was not offered to a stage"; }
    if (r.stage(item: Probe.make(seq: 97))) { return "a stage past the capacity was taken after a pop"; }
    r.publish();
    i = 1;
    while (i < 5) {
        string why = expectSeq(r: r, seq: i);
        if (!why.isEmpty()) { return why; }
        i = i + 1;
    }
    return expectEmpty(r: r);
}

fn string pushPublishesStaged(ref Ring<Probe> r) {
    if (!r.stage(item: Probe.make(seq: 0))) { return "a stage onto an empty ring was refused"; }
    if (!r.push(item: Probe.make(seq: 1))) { return "a push after a stage was refused"; }
    string first = expectSeq(r: r, seq: 0);
    if (!first.isEmpty()) { return first; }
    string second = expectSeq(r: r, seq: 1);
    if (!second.isEmpty()) { return second; }
    r.publish();
    return expectEmpty(r: r);
}

fn string roomOf(ref Ring<Probe> r, isize want, const ref string moment) {
    isize n = r.room();
    return n == want ? "" : "${moment}: the room was ${n} where ${want} was due";
}

// The room counts what is staged and what the consumer has not popped, grows only as the consumer pops, and a stage it
// allows is taken.
fn string roomCounts(ref Ring<Probe> r) {
    string why = roomOf(r: r, want: 4, moment: "a fresh ring of 4");
    if (!why.isEmpty()) { return why; }
    if (!r.stage(item: Probe.make(seq: 0))) { return "a stage onto an empty ring was refused"; }
    why = roomOf(r: r, want: 3, moment: "one staged");
    if (!why.isEmpty()) { return why; }
    r.publish();
    why = roomOf(r: r, want: 3, moment: "one published");
    if (!why.isEmpty()) { return why; }
    if (!r.push(item: Probe.make(seq: 1))) { return "a push onto a ring of 4 holding one was refused"; }
    why = roomOf(r: r, want: 2, moment: "two published");
    if (!why.isEmpty()) { return why; }
    why = expectSeq(r: r, seq: 0);
    if (!why.isEmpty()) { return why; }
    why = roomOf(r: r, want: 3, moment: "one of two popped");
    if (!why.isEmpty()) { return why; }
    int64 i = 2;
    while (i < 5) {
        if (!r.stage(item: Probe.make(seq: i))) { return "stage ${i} was refused with room for it"; }
        i = i + 1;
    }
    why = roomOf(r: r, want: 0, moment: "one published and three staged");
    if (!why.isEmpty()) { return why; }
    if (r.stage(item: Probe.make(seq: 99))) { return "a ring with no room took a stage"; }
    r.publish();
    i = 1;
    while (i < 5) {
        why = expectSeq(r: r, seq: i);
        if (!why.isEmpty()) { return why; }
        i = i + 1;
    }
    return roomOf(r: r, want: 4, moment: "every item popped, the counters past the capacity");
}

// ---- across threads -----------------------------------------------------------------------------------------------

fn int64 pushOne(ref Crossing c, int64 next) {
    if (next >= COUNT) { return next; }
    return c.push(item: Probe.make(seq: next)) ? next + 1 : next;
}

// Stages one at a time, and publishes each time a batch is complete.
fn int64 stageInBatches(ref Crossing c, int64 next) {
    if (next >= COUNT) { return next; }
    if (!c.stage(item: Probe.make(seq: next))) { return next; }
    int64 b = c.batchSize();
    if ((next + 1) % b == 0) { c.publish(); }
    return next + 1;
}

unsafe fn void ringTests(ref Tally t) {
    withRing(t: t, name: "command-ring: a fresh ring is empty, at its declared capacity", capacity: 4, body: freshIsEmpty);
    withRing(t: t, name: "command-ring: what is pushed is popped in order", capacity: 8, body: inOrder);
    withRing(t: t, name: "command-ring: a full ring refuses a push and keeps what it holds", capacity: 4, body: fullRefuses);
    withRing(t: t, name: "command-ring: its counters wrap past a capacity of 3, in order", capacity: 3, body: wraps);
    badCapacity(t: t);
    fromTheAllocator(t: t);
    noRoom(t: t);
    withRing(t: t, name: "command-ring: a staged item is not popped until it is published, then in order", capacity: 8,
             body: stagedUnseen);
    withRing(t: t, name: "command-ring: what is staged counts against the capacity, and staging past it is refused",
             capacity: 4, body: stagedCounts);
    withRing(t: t, name: "command-ring: a push publishes what was staged before it", capacity: 4, body: pushPublishesStaged);
    withRing(t: t, name: "command-ring: its room counts what is staged and what is not popped, and grows only as items are popped",
             capacity: 4, body: roomCounts);
    crossing(t: t, name: "command-ring: a million commands cross to another thread whole and in order", batch: 1,
             step: pushOne);
    crossing(t: t, name: "command-ring: a million commands staged in batches of 5 cross to another thread, each batch whole",
             batch: 5, step: stageInBatches);
}
